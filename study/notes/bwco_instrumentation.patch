+template <uint32_t ACCS>
+static __attribute__((noinline)) void walk_nomem(kernel_arg_t* __UNIFORM__ arg) {
+  auto pA = reinterpret_cast<ctx::input_t *>(arg->A_addr);
+  auto pB = reinterpret_cast<ctx::input_t *>(arg->B_addr);
+  auto pC = reinterpret_cast<ctx::output_t *>(arg->C_addr);
+  const size_t N = arg->N;
+  const size_t K = arg->K;
+  const uint32_t warp = get_sub_group_id();
+  const uint32_t num_warps = get_num_sub_groups();
+  const uint32_t cta_cols = num_warps * ctx::tileN;
+  const size_t tile_col = (size_t)blockIdx.x * cta_cols + warp * ctx::tileN;
+  const uint32_t bar0 = get_local_group_id();
+  ctx::fragment_a fragA;
+  ctx::fragment_b fragB;
+  ctx::fragment_acc acc[ACCS];
+  vt::unroll_for<ACCS>([&](auto m) {
+    ctx::fill_fragment(acc[decltype(m)::value], 0);
+  });
+  ctx::load_matrix_sync(fragA, pA, K);
+  ctx::load_matrix_sync<vt::col_major>(fragB, pB, K);
+#ifdef PROFILE_ENABLE
+  __rdcycle_time t0 = vx_rdcycle_sync_begin();
+#endif
+  const uint32_t chunks = K / arg->chunk_k;
+  for (uint32_t i = 0; i < chunks; ++i) {
+    vx_barrier(bar0, num_warps);
+    for (uint32_t k = 0; k < arg->chunk_k; k += ctx::tileK) {
+      vt::unroll_for<MTILES>([&](auto m) {
+        constexpr uint32_t a = decltype(m)::value % ACCS;
+        ctx::mma_sync(acc[a], fragA, fragB, acc[a]);
+      });
+    }
+    vx_barrier(bar0, num_warps);
+  }
+#ifdef PROFILE_ENABLE
+  __rdcycle_time t1 = vx_rdcycle_sync_end();
+  reinterpret_cast<uint32_t*>(arg->cycles_addr)[blockIdx.x * num_warps + warp] = vx_rdcycle_sync_diff(t0, t1);
+#endif
+  vt::unroll_for<ACCS>([&](auto m) {
+    constexpr uint32_t mt = decltype(m)::value;
+    ctx::store_matrix_sync(pC + (size_t)mt * ctx::tileM * N + tile_col, acc[mt], N);
+  });
+#ifdef PROFILE_ENABLE
+  record_cta(arg, t0.lo);
+#else
+  record_cta(arg, 0);
+#endif
+}
