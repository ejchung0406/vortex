@@ -3231,9 +3239,10 @@
     if (config_.nc_enable) {
       ++core_rsp_delay_;
     }
+    __assert(config_.crsq_size == 0 || port_arb_->merge_bits() != 0, "a deeper core-response queue is modeled under read merging only");
     if (port_arb_->merge_bits() != 0) {
