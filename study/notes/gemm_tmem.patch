+
+include ../common.mk
diff -ruN '--exclude=.git' '--exclude=build' src_tmem/tests/regression/gemm_tmem_decode/common.h src_tmemk/tests/regression/gemm_tmem_decode/common.h
--- src_tmem/tests/regression/gemm_tmem_decode/common.h	1969-12-31 19:00:00.000000000 -0500
+++ src_tmemk/tests/regression/gemm_tmem_decode/common.h	2026-11-21 13:09:51.872495377 -0500
@@ -0,0 +1,85 @@
+#ifndef _COMMON_H_
+#define _COMMON_H_
+
+#include <stdint.h>
+
+#ifndef ITYPE
+#define ITYPE fp16
+#endif
+
+#ifndef OTYPE
+#define OTYPE fp32
+#endif
+
+// Accumulator registers of an epilogue transfer.
+#define GEMM_NRC 32
+
+// Columns of one tc.mma (the N tile of a CTA), at most 128 fragments. A CTA
+// keeps two tiles' accumulators in TMEM, so one drains while the next fills.
+#ifndef TILE_N
+#define TILE_N 512
+#endif
+
+// tc.mma K steps per pipeline stage.
+#ifndef KSTEPS
+#define KSTEPS 1
+#endif
+
+// Pipeline stages: buffers of a stage's A and W slabs in shared memory.
+#ifndef PIPE
+#define PIPE 5
+#endif
+
+// Bytes of W one staging transfer (or one load-staging pass) moves.
+#ifndef XFER
+#define XFER (TILE_N * 32)
+#endif
+
+// How W sits in global memory:
+#define LAYOUT_PACKED 0  // [N/TILE_N][K/kstep][TILE_N][kstep]: a stage is one contiguous run
+#define LAYOUT_NK16   1  // W[N][K]: rows of one K step (32 B), each 64 B line read twice
+#define LAYOUT_NK32   2  // W[N][K]: rows of two K steps (one 64 B line), read once
+#define LAYOUT_KN     3  // W[K][N]: transposed by the DXA's K-major scatter
+#ifndef LAYOUT
+#define LAYOUT LAYOUT_PACKED
+#endif
+
+// How a stage reaches shared memory: 0 the DXA, 1 loads by LOAD_WARPS warps.
+#ifndef STAGE_LOAD
+#define STAGE_LOAD 0
+#endif
+
+#ifndef LOAD_WARPS
+#define LOAD_WARPS 16
+#endif
+
+// 1: the DXA producer and the MMA warp run the ring unrolled by PIPE (fewer
+// instructions per stage); 0: the loop indexes the ring with g % PIPE.
+#ifndef LEAN_ISSUE
+#define LEAN_ISSUE 0
+#endif
+
+// Warps that read the stages with loads instead of the tensor engine (0: the engine).
+#ifndef CONSUME_WARPS
+#define CONSUME_WARPS 0
+#endif
+
+// Shared memory starts with the CTA's TMEM column, padded to a bank row.
+#define TMEM_SLOT_BYTES 128
+
+// Warps: 0 the DXA producer, 1 the MMA issuer, 4..7 the epilogue (warp r
+// drains TCU block r % 4), from 8 the loaders when STAGE_LOAD.
+#define EPI_WARP0  4
+#define LOAD_WARP0 8
+
+typedef struct {
+  uint32_t M, N, K;
+  uint32_t passes;       // times the CTAs walk the N tiles (a copy that re-reads W from the L2)
+  uint64_t A_addr;      // [K/kstep][M][kstep]
+  uint64_t W_addr;      // LAYOUT
+  uint64_t C_addr;      // [16 * ceil(M / 16)][N] fp32
+  uint64_t times_addr;  // per tile: core, multiply begin, multiply end, epilogue end;
+                        // then per CTA: begin, end
+} kernel_arg_t;
+
+#endif
diff -ruN '--exclude=.git' '--exclude=build' src_tmem/tests/regression/gemm_tmem_decode/kernel.cpp src_tmemk/tests/regression/gemm_tmem_decode/kernel.cpp
--- src_tmem/tests/regression/gemm_tmem_decode/kernel.cpp	1969-12-31 19:00:00.000000000 -0500
+++ src_tmemk/tests/regression/gemm_tmem_decode/kernel.cpp	2026-11-21 13:44:13.229418645 -0500
@@ -0,0 +1,380 @@
+#include "common.h"
+#include <vx_spawn2.h>
+#include <vx_tensor.h>
+#include <vx_tmem.h>
+#include <vx_intrinsics.h>
+#include <vx_dxa.h>
+#include <vx_barrier.h>
+
+// Decode-shaped C = A W: a few rows of A (M <= 64, the 64 lanes of one
+// tc.mma; lanes past M compute on whatever shared memory holds and are not
+// stored) against a weight matrix W read once. A persistent CTA computes N
+// tiles cta, cta + grid, ..., each TILE_N columns over all of K, into one of
+// two TMEM accumulator buffers, so the epilogue of a tile overlaps the next
+// tile's multiplies. Each pipeline stage holds KSTEPS K steps of A and of the
+// tile's W, staged by the DXA (warp 0) or by loads (the loader warps); warp 1
+// issues one tc.mma per K step. In shared memory a K step of A is M rows of
+// 32 bytes and a K step of W is TILE_N rows of 32 bytes (LAYOUT_NK32: rows of
+// 64 bytes holding two K steps). NO_MMA (a measurement of the staging
+// alone) releases each stage without multiplying. CONSUME_WARPS > 0 replaces
+// the tensor engine with that many warps that read each stage of W with loads
+// and checksum it (READ_ONLY: the stages are not refilled, the warps only read).
+namespace vt = vortex::tensor;
+namespace tm = vortex::tmem;
+using ctx = vt::wgmma_context<VX_CFG_NUM_THREADS, vt::ITYPE, vt::OTYPE, false, GEMM_NRC>;
+using wg_cfg = vt::wgmma_config_t<VX_CFG_NUM_THREADS, vt::ITYPE, vt::OTYPE, GEMM_NRC>;
+
+[[maybe_unused]] constexpr uint32_t kDescA = 0;
+constexpr uint32_t kDescW = 1;
+
+constexpr uint32_t kBlocks   = VX_CFG_NUM_TCU_BLOCKS;
+constexpr uint32_t kStepK    = wg_cfg::fedpK * wg_cfg::i_ratio;  // K elements of one tc.mma
+constexpr uint32_t kStepRow  = wg_cfg::fedpK * 4;          // bytes of one row's K step
+constexpr uint32_t kRowBytes = (LAYOUT == LAYOUT_NK32) ? 2 * kStepRow : kStepRow;
+constexpr uint32_t kStageW   = KSTEPS * TILE_N * kStepRow;
+[[maybe_unused]] constexpr uint32_t kXfers = kStageW / XFER;  // W transfers per stage
+constexpr uint32_t kNFrag    = TILE_N / wg_cfg::tcN;
+
+static_assert(kBlocks * wg_cfg::xtileM == 64, "a tc.mma covers 64 rows");
+static_assert(kNFrag <= 128 && TILE_N % ctx::xtileN == 0, "TILE_N: at most 128 fragments, whole transfers");
+static_assert(2 * TILE_N <= VX_CFG_TCU_TMEM_COLS, "two accumulator buffers exceed TMEM");
+static_assert(2 * PIPE + 4 <= VX_CFG_NUM_BARRIERS, "not enough barriers for PIPE");
+static_assert(kStageW % XFER == 0 && XFER % kRowBytes == 0, "XFER: whole rows, divides a stage");
+static_assert(LAYOUT != LAYOUT_NK32 || KSTEPS % 2 == 0, "LAYOUT_NK32 stages K steps in pairs");
+static_assert(!STAGE_LOAD || LAYOUT == LAYOUT_PACKED, "load staging copies the packed layout");
+static_assert(!(STAGE_LOAD != 0 && CONSUME_WARPS != 0), "the loaders and the consumers share warp ranks");
+static_assert(CONSUME_WARPS == 0 || LAYOUT == LAYOUT_PACKED, "the consumers checksum the packed layout");
+static_assert(LEAN_ISSUE == 0 || LAYOUT == LAYOUT_PACKED, "the lean producer issues the packed layout");
+static_assert(sizeof(ctx::output_t) == sizeof(float), "the epilogue stores fp32 lanes");
+
+typedef uint64_t __attribute__((may_alias)) word_t;
+
+__kernel void kernel_main(kernel_arg_t* __UNIFORM__ arg) {
+  const uint32_t warp_rank = threadIdx.x / VX_CFG_NUM_THREADS;
+  const uint32_t num_warps = blockDim.x / VX_CFG_NUM_THREADS;
+  const uint32_t M = arg->M, N = arg->N;
+  const uint32_t k_steps = arg->K / kStepK;
+  const uint32_t num_stages = k_steps / KSTEPS;
+  const uint32_t num_tiles = N / TILE_N;
+  const uint32_t total_tiles = num_tiles * arg->passes;
+  const uint32_t cta = blockIdx.x;
+  // The A region holds what the 64 lanes of the last K step read: lanes past
+  // M must not read W, which the tile buffer fetches at the same time.
+  const uint32_t stage_a = ((KSTEPS - 1) * M * kStepRow + 64 * kStepRow + 127) / 128 * 128;
+  const uint32_t stage_bytes = stage_a + kStageW;
+  // Epilogue warps with lanes below M, and the participants of the barriers
+  // between the stagers and the MMA warp.
+  const uint32_t epi = (M + wg_cfg::xtileM - 1) / wg_cfg::xtileM;
+  const uint32_t stagers = STAGE_LOAD ? LOAD_WARPS : 1;
+  // The other side of the stage barriers: the MMA warp, or the consumer warps.
+  const uint32_t takers = CONSUME_WARPS ? CONSUME_WARPS : 1;
+
+  auto lmem = reinterpret_cast<uint8_t*>(__local_mem());
+  auto tmem_slot = reinterpret_cast<volatile uint32_t*>(lmem);
+  uint8_t* stages = lmem + TMEM_SLOT_BYTES;
+
+  const uint32_t cta_id = get_local_group_id();
+  auto full_bar  = [&](uint32_t s) { return cta_id | (s << 8); };
+  auto empty_bar = [&](uint32_t s) { return cta_id | ((PIPE + s) << 8); };
+  auto acc_empty = [&](uint32_t b) { return cta_id | ((2 * PIPE + b) << 8); };
+  const uint32_t acc_full = cta_id | ((2 * PIPE + 2) << 8);
+  const uint32_t sync_bar = cta_id | ((2 * PIPE + 3) << 8);
+
+  auto pT = reinterpret_cast<uint64_t*>(arg->times_addr);
+  auto pCta = pT + 4 * total_tiles + 2 * cta;
+  if (warp_rank == 0) {
+    uint32_t col = tm::alloc(2 * TILE_N);
+    if (vx_thread_id() == 0) {
+      *tmem_slot = col;
+      pCta[0] = csr_read(VX_CSR_MCYCLE);
+    }
+  }
+  vx_barrier(sync_bar, num_warps);
+  const uint32_t taddr = *tmem_slot;
+
+#if LEAN_ISSUE
+  if (warp_rank == 0 && !STAGE_LOAD) {
+    // DXA producer with the ring unrolled by PIPE, so a stage's barriers and
+    // buffer are constants and the source coordinate advances by one add: a
+    // lone warp issues one instruction per schedule-to-decode round trip
+    // (about 10 cycles), so the instructions per transfer set its rate.
+    constexpr uint32_t kStageCoord = kStageW / XFER;
+    uint32_t tile = cta, i = 0, ks0 = 0, g = 0;
+    uint32_t coord = (tile % num_tiles) * num_stages * kStageCoord;
+    bool wrapped = false;
+    while (tile < total_tiles) {
+      #pragma unroll
+      for (uint32_t s = 0; s < PIPE; ++s) {
+        if (tile >= total_tiles) break;
+        if (wrapped) {
+          int phase = vx_barrier_arrive(empty_bar(s), takers + 1);
+          vx_barrier_wait(empty_bar(s), phase);
+        }
+        uint8_t* buf = stages + s * stage_bytes;
+      #if defined(READ_ONLY)
+        (void)buf;  // the stages keep what they hold
+      #elif defined(NO_MMA) || CONSUME_WARPS
+        vx_barrier_expect_tx(full_bar(s), kXfers);
+      #else
+        vx_barrier_expect_tx(full_bar(s), 1 + kXfers);
+        vx_dxa_issue_2d_wg(kDescA, full_bar(s), buf, 0, ks0);
+      #endif
+      #ifndef READ_ONLY
+        #pragma unroll
+        for (uint32_t q = 0; q < kXfers; ++q) {
+          vx_dxa_issue_2d_wg(kDescW, full_bar(s), buf + stage_a + q * XFER, 0, coord + q);
+        }
+      #endif
+        vx_barrier_arrive(full_bar(s), takers + 1);
+        ++g;
+        coord += kStageCoord;
+        ks0 += KSTEPS;
+        if (++i == num_stages) {
+          i = 0;
+          ks0 = 0;
+          tile += gridDim.x;
+          coord = (tile % num_tiles) * num_stages * kStageCoord;
+        }
+      }
+      wrapped = true;
+    }
+    (void)ks0;    // the A coordinate, unused when only W is staged
+    (void)coord;  // and the W coordinate, when nothing is
+    for (uint32_t i = (g > PIPE) ? (g - PIPE) : 0; i < g; ++i) {
+      int phase = vx_barrier_arrive(empty_bar(i % PIPE), takers + 1);
+      vx_barrier_wait(empty_bar(i % PIPE), phase);
+    }
+  } else
+#endif
+  if (warp_rank == 0 && !STAGE_LOAD) {
+    // DXA producer: one transfer of A and kXfers of W per stage.
+    uint32_t g = 0;
+    for (uint32_t tile = cta; tile < total_tiles; tile += gridDim.x) {
+      for (uint32_t i = 0; i < num_stages; ++i, ++g) {
+        uint32_t s = g % PIPE;
+        if (g >= PIPE) {
+          int phase = vx_barrier_arrive(empty_bar(s), takers + 1);
+          vx_barrier_wait(empty_bar(s), phase);
+        }
+        uint8_t* buf = stages + s * stage_bytes;
+        const uint32_t ks0 = i * KSTEPS;
+      #if defined(READ_ONLY)
+        // The stages keep what they hold: the consumers measure reads alone.
+      #elif defined(NO_MMA) || CONSUME_WARPS
+        // Staging alone: the transfers of W only, as a copy of W.
+        vx_barrier_expect_tx(full_bar(s), kXfers);
+      #else
+        vx_barrier_expect_tx(full_bar(s), 1 + kXfers);
+        vx_dxa_issue_2d_wg(kDescA, full_bar(s), buf, 0, ks0);
+      #endif
+      #ifdef READ_ONLY
+        for (uint32_t q = 0; q < 0; ++q) {
+      #else
+        for (uint32_t q = 0; q < kXfers; ++q) {
+      #endif
+          uint8_t* dst = buf + stage_a + q * XFER;
+        #if LAYOUT == LAYOUT_PACKED
+          vx_dxa_issue_2d_wg(kDescW, full_bar(s), dst, 0, (((tile % num_tiles) * k_steps + ks0) * TILE_N * kStepRow + q * XFER) / XFER);
+        #else
+          // Transfer q: rows p * (XFER / kRowBytes) on of its K step (pair) j.
+          constexpr uint32_t kPer = TILE_N * kRowBytes / XFER;
+          constexpr uint32_t kRows = XFER / kRowBytes;
+          const uint32_t j = q / kPer, n0 = (tile % num_tiles) * TILE_N + (q % kPer) * kRows;
+          #if LAYOUT == LAYOUT_NK16
+          vx_dxa_issue_3d_wg(kDescW, full_bar(s), dst, 0, n0, ks0 + j);
+          #elif LAYOUT == LAYOUT_NK32
+          vx_dxa_issue_3d_wg(kDescW, full_bar(s), dst, 0, n0, ks0 / 2 + j);
+          #else
+          vx_dxa_issue_2d_wg(kDescW, full_bar(s), dst, n0, (ks0 + j) * kStepK);
+          #endif
+        #endif
+        }
+        vx_barrier_arrive(full_bar(s), takers + 1);
+      }
+    }
+    for (uint32_t i = (g > PIPE) ? (g - PIPE) : 0; i < g; ++i) {
+      int phase = vx_barrier_arrive(empty_bar(i % PIPE), takers + 1);
+      vx_barrier_wait(empty_bar(i % PIPE), phase);
+    }
+  } else if (STAGE_LOAD && warp_rank >= LOAD_WARP0) {
+    // Loaders: thread t copies words t, t + T, ... of the stage, every load
+    // of the stage before its stores.
+    constexpr uint32_t kT = LOAD_WARPS * VX_CFG_NUM_THREADS;
+    constexpr uint32_t kWords = kStageW / sizeof(word_t) / kT;
+    static_assert(kStageW % (sizeof(word_t) * kT) == 0, "a stage is whole words per loader thread");
+    const uint32_t t = threadIdx.x - LOAD_WARP0 * VX_CFG_NUM_THREADS;
+    const uint32_t a_words = KSTEPS * M * kStepRow / sizeof(word_t);
+    auto pA = reinterpret_cast<const word_t*>(arg->A_addr);
+    auto pW = reinterpret_cast<const word_t*>(arg->W_addr);
+    uint32_t g = 0;
+    for (uint32_t tile = cta; tile < total_tiles; tile += gridDim.x) {
+      for (uint32_t i = 0; i < num_stages; ++i, ++g) {
+        uint32_t s = g % PIPE;
+        if (g >= PIPE) {
+          int phase = vx_barrier_arrive(empty_bar(s), LOAD_WARPS + 1);
+          vx_barrier_wait(empty_bar(s), phase);
+        }
+        auto dst = reinterpret_cast<word_t*>(stages + s * stage_bytes);
+        const uint32_t ks0 = i * KSTEPS;
+        auto src = pW + size_t((tile % num_tiles) * k_steps + ks0) * TILE_N * kStepRow / sizeof(word_t) + t;
+        word_t v[kWords];
+        #pragma unroll
+        for (uint32_t w = 0; w < kWords; ++w) {
+          v[w] = src[w * kT];
+        }
+        word_t a = (t < a_words) ? pA[size_t(ks0) * M * kStepRow / sizeof(word_t) + t] : 0;
+        #pragma unroll
+        for (uint32_t w = 0; w < kWords; ++w) {
+          dst[stage_a / sizeof(word_t) + t + w * kT] = v[w];
+        }
+        if (t < a_words) {
+          dst[t] = a;
+        }
+        vx_barrier_arrive(full_bar(s), LOAD_WARPS + 1);
+      }
+    }
+    for (uint32_t i = (g > PIPE) ? (g - PIPE) : 0; i < g; ++i) {
+      int phase = vx_barrier_arrive(empty_bar(i % PIPE), LOAD_WARPS + 1);
+      vx_barrier_wait(empty_bar(i % PIPE), phase);
+    }
+  } else if (CONSUME_WARPS != 0 && warp_rank >= LOAD_WARP0) {
+    // Consumers: thread t reads words t, t + T, ... of each stage of W and
+    // XORs them; the checksum goes to C for the host to check.
+    constexpr uint32_t kT = CONSUME_WARPS * VX_CFG_NUM_THREADS;
+    const uint32_t t = threadIdx.x - LOAD_WARP0 * VX_CFG_NUM_THREADS;
+    word_t sum = 0;
+    uint32_t g = 0;
+    for (uint32_t tile = cta; tile < total_tiles; tile += gridDim.x) {
+      for (uint32_t i = 0; i < num_stages; ++i, ++g) {
+        uint32_t s = g % PIPE;
+        int phase = vx_barrier_arrive(full_bar(s), takers + 1);
+        vx_barrier_wait(full_bar(s), phase);
+        if (i == 0 && t == 0) {
+          pT[4 * tile + 0] = vx_core_id();
+          pT[4 * tile + 1] = csr_read(VX_CSR_MCYCLE);
+        }
+        auto w = reinterpret_cast<const volatile word_t*>(stages + s * stage_bytes + stage_a);
+        #pragma unroll 4
+        for (uint32_t j = t; j < kStageW / sizeof(word_t); j += kT) {
+          sum ^= w[j];
+        }
+        vx_barrier_arrive(empty_bar(s), takers + 1);
+      }
+      if (t == 0) {
+        pT[4 * tile + 2] = csr_read(VX_CSR_MCYCLE);
+        pT[4 * tile + 3] = pT[4 * tile + 2];
+      }
+    }
+    reinterpret_cast<word_t*>(arg->C_addr)[cta * kT + t] = sum;
+#if LEAN_ISSUE
+  } else if (warp_rank == 1 && CONSUME_WARPS == 0) {
+    // MMA issuer, the ring unrolled by PIPE as in the producer.
+    const uint32_t base = tm::smem_offset(stages);
+    uint32_t tile = cta, i = 0, j = 0, d_col = taddr;
+    while (tile < total_tiles) {
+      #pragma unroll
+      for (uint32_t s = 0; s < PIPE; ++s) {
+        if (tile >= total_tiles) break;
+        if (i == 0) {
+          d_col = taddr + (j % 2) * TILE_N;
+          if (j >= 2) {
+            int phase = vx_barrier_arrive(acc_empty(j % 2), epi + 1);
+            vx_barrier_wait(acc_empty(j % 2), phase);
+          }
+        }
+        int phase = vx_barrier_arrive(full_bar(s), stagers + 1);
+        vx_barrier_wait(full_bar(s), phase);
+        if (i == 0 && vx_thread_id() == 0) {
+          pT[4 * tile + 0] = vx_core_id();
+          pT[4 * tile + 1] = csr_read(VX_CSR_MCYCLE);
+        }
+      #ifndef NO_MMA
+        const uint32_t a_off = base + s * stage_bytes;
+        const uint32_t w_off = a_off + stage_a;
+        #pragma unroll
+        for (uint32_t k = 0; k < KSTEPS; ++k) {
+          const uint32_t w_k = (LAYOUT == LAYOUT_NK32) ? (k / 2) * TILE_N * kRowBytes + (k % 2) * kStepRow
+                                                       : k * TILE_N * kStepRow;
+          tm::mma(tm::make_idesc<vt::ITYPE>(kNFrag, d_col, i == 0 && k == 0),
+                  tm::smem_desc(a_off + k * M * kStepRow, kStepRow), tm::smem_desc(w_off + w_k, kRowBytes));
+        }
+      #else
+        (void)base; (void)d_col;
+      #endif
+        tm::commit(empty_bar(s), stagers + 1);
+        if (++i == num_stages) {
+          i = 0;
+          tm::commit(acc_full, epi + 1);
+          tile += gridDim.x;
+          ++j;
+        }
+      }
+    }
+#endif
+  } else if (warp_rank == 1 && CONSUME_WARPS == 0 && LEAN_ISSUE == 0) {
+    // MMA issuer: one tc.mma per K step into the tile's accumulator buffer,
+    // which the epilogue must have drained two tiles ago.
+    const uint32_t base = tm::smem_offset(stages);
+    uint32_t g = 0, j = 0;
+    for (uint32_t tile = cta; tile < total_tiles; tile += gridDim.x, ++j) {
+      const uint32_t d_col = taddr + (j % 2) * TILE_N;
+      if (j >= 2) {
+        int phase = vx_barrier_arrive(acc_empty(j % 2), epi + 1);
+        vx_barrier_wait(acc_empty(j % 2), phase);
+      }
+      for (uint32_t i = 0; i < num_stages; ++i, ++g) {
+        uint32_t s = g % PIPE;
+        int phase = vx_barrier_arrive(full_bar(s), stagers + 1);
+        vx_barrier_wait(full_bar(s), phase);
+        if (i == 0 && vx_thread_id() == 0) {
+          pT[4 * tile + 0] = vx_core_id();
+          pT[4 * tile + 1] = csr_read(VX_CSR_MCYCLE);
+        }
+        const uint32_t a_off = base + s * stage_bytes;
+        const uint32_t w_off = a_off + stage_a;
+      #ifndef NO_MMA
+        #pragma unroll
+        for (uint32_t k = 0; k < KSTEPS; ++k) {
+          const uint32_t w_k = (LAYOUT == LAYOUT_NK32) ? (k / 2) * TILE_N * kRowBytes + (k % 2) * kStepRow
+                                                       : k * TILE_N * kStepRow;
+          tm::mma(tm::make_idesc<vt::ITYPE>(kNFrag, d_col, i == 0 && k == 0),
+                  tm::smem_desc(a_off + k * M * kStepRow, kStepRow), tm::smem_desc(w_off + w_k, kRowBytes));
+        }
+      #else
+        (void)a_off; (void)w_off; (void)d_col;
+      #endif
+        tm::commit(empty_bar(s), stagers + 1);
+      }
+      tm::commit(acc_full, epi + 1);
+    }
+  } else if (CONSUME_WARPS == 0 && warp_rank >= EPI_WARP0 && warp_rank < EPI_WARP0 + epi) {
+    // Epilogue: this warp's block's lanes of the tile's buffer, rows below M
+    // only (C has rows up to the block's last lane).
+    const uint32_t lane = tm::warp_lane();
+    uint32_t j = 0;
+    for (uint32_t tile = cta; tile < total_tiles; tile += gridDim.x, ++j) {
+      vx_barrier(acc_full, epi + 1);
+      if (warp_rank == EPI_WARP0 && vx_thread_id() == 0) {
+        pT[4 * tile + 2] = csr_read(VX_CSR_MCYCLE);
+      }
+      auto pC = reinterpret_cast<ctx::output_t*>(arg->C_addr) + size_t(lane) * N + (tile % num_tiles) * TILE_N;
+      for (uint32_t c = 0; c < TILE_N; c += ctx::xtileN) {
+        ctx::fragment_acc frag;
+        tm::load<tm::FRAGMENT>(frag, tm::make_taddr(lane, taddr + (j % 2) * TILE_N + c));
+        ctx::store_matrix_sync(pC + c, frag, N);
+      }
+      vx_barrier_arrive(acc_empty(j % 2), epi + 1);
+      if (warp_rank == EPI_WARP0 && vx_thread_id() == 0) {
+        pT[4 * tile + 3] = csr_read(VX_CSR_MCYCLE);
+      }
+    }
+  }
+
+  vx_barrier(sync_bar, num_warps);
+  if (warp_rank == 0) {
+    tm::dealloc(taddr, 2 * TILE_N);
+    if (vx_thread_id() == 0) {
+      pCta[1] = csr_read(VX_CSR_MCYCLE);
+    }
+  }
+}
diff -ruN '--exclude=.git' '--exclude=build' src_tmem/tests/regression/gemm_tmem_decode/main.cpp src_tmemk/tests/regression/gemm_tmem_decode/main.cpp
--- src_tmem/tests/regression/gemm_tmem_decode/main.cpp	1969-12-31 19:00:00.000000000 -0500
+++ src_tmemk/tests/regression/gemm_tmem_decode/main.cpp	2026-11-21 13:18:49.676899734 -0500
@@ -0,0 +1,364 @@
+#include "common.h"
+#include <algorithm>
+#include <cmath>
+#include <iostream>
+#include <rvfloats.h>
+#include <string>
+#include <string.h>
+#include <tensor_cfg.h>
+#include <type_traits>
+#include <unistd.h>
+#include <util.h>
+#include <vector>
+#include <vortex2.h>
+#include <dxa.h>
+
+#define MAX_ERRORS 100
+
+#define RT_CHECK(_expr)                                      \
+  do {                                                       \
+    int _ret = _expr;                                        \
+    if (0 == _ret)                                           \
+      break;                                                 \
+    printf("Error: '%s' returned %d!\n", #_expr, (int)_ret); \
+    cleanup();                                               \
+    exit(-1);                                                \
+  } while (false)
+
+using namespace vortex;
+namespace vt = tensor;
+
+static_assert(std::is_same<vt::ITYPE, vt::fp16>::value, "gemm_tmem_decode generates fp16 operands");
+static_assert(std::is_same<vt::OTYPE, vt::fp32>::value, "gemm_tmem_decode accumulates in fp32");
+
+using cfg = vt::wgmma_config_t<VX_CFG_NUM_THREADS, vt::ITYPE, vt::OTYPE, GEMM_NRC>;
+using itype_t = vt::ITYPE::dtype;
+
+constexpr uint32_t kStepK   = cfg::fedpK * cfg::i_ratio;
+constexpr uint32_t kStepRow = kStepK * sizeof(itype_t);
+constexpr uint32_t kStageW  = KSTEPS * TILE_N * kStepRow;
+
+// The drift of the tensor core's fp32 accumulation from a double reference
+// tracks K (sgemm_tcu_tmem's bound).
+static uint32_t float_ulp(uint32_t K) {
+  return std::max<uint32_t>(8, K / 5);
+}
+
+const char *kernel_file = "kernel.vxbin";
+uint32_t xm = 16;
+uint32_t xn = 8192;
+uint32_t xk = 4096;
+uint32_t xP = 1;  // passes over the N tiles
+bool xa = false;  // place the buffers past the heap's first 2 MB
+
+vx_device_h device = nullptr;
+vx_buffer_h A_buffer = nullptr;
+vx_buffer_h W_buffer = nullptr;
+vx_buffer_h C_buffer = nullptr;
+vx_buffer_h T_buffer = nullptr;
+vx_buffer_h pad_buffer = nullptr;
+vx_queue_h  queue = nullptr;
+vx_module_h module_ = nullptr;
+vx_kernel_h kernel = nullptr;
+kernel_arg_t kernel_arg = {};
+
+static void show_usage() {
+  std::cout << "Vortex tensor-memory decode GEMM." << std::endl;
+  std::cout << "Usage: [-m M (1..64)] [-n N] [-k K] [-P passes over W] [-a: buffers past the first 2 MB] [-h: help]" << std::endl;
+}
+
+static void parse_args(int argc, char **argv) {
+  int c;
+  while ((c = getopt(argc, argv, "m:n:k:P:ah")) != -1) {
+    switch (c) {
+    case 'm': xm = atoi(optarg); break;
+    case 'n': xn = atoi(optarg); break;
+    case 'k': xk = atoi(optarg); break;
+    case 'P': xP = atoi(optarg); break;
+    case 'a': xa = true; break;
+    case 'h': show_usage(); exit(0); break;
+    default:  show_usage(); exit(-1);
+    }
+  }
+}
+
+void cleanup() {
+  if (device) {
+    if (A_buffer) vx_buffer_release(A_buffer);
+    if (W_buffer) vx_buffer_release(W_buffer);
+    if (C_buffer) vx_buffer_release(C_buffer);
+    if (T_buffer) vx_buffer_release(T_buffer);
+    if (pad_buffer) vx_buffer_release(pad_buffer);
+    if (kernel)  vx_kernel_release(kernel);
+    if (module_) vx_module_release(module_);
+    if (queue)   vx_queue_release(queue);
+    vx_device_dump_perf(device, stdout);
+    vx_device_release(device);
+  }
+}
+
+static void reject(const std::string& msg) {
+  std::cout << "Error: " << msg << "!" << std::endl;
+  cleanup();
+  exit(-1);
+}
+
+int main(int argc, char *argv[]) {
+  parse_args(argc, argv);
+  std::srand(50);
+
+  RT_CHECK(vx_device_open(0, &device));
+  vx_queue_info_t qi = { sizeof(qi), nullptr, VX_QUEUE_PRIORITY_NORMAL, 0 };
+  RT_CHECK(vx_queue_create(device, &qi, &queue));
+
+  uint64_t isa_flags, NT, issue_width, num_cores, lmem_bytes;
+  RT_CHECK(vx_device_query(device, VX_CAPS_ISA_FLAGS, &isa_flags));
+  RT_CHECK(vx_device_query(device, VX_CAPS_NUM_THREADS, &NT));
+  RT_CHECK(vx_device_query(device, VX_CAPS_ISSUE_WIDTH, &issue_width));
+  RT_CHECK(vx_device_query(device, VX_CAPS_NUM_CORES, &num_cores));
+  RT_CHECK(vx_device_query(device, VX_CAPS_LOCAL_MEM_SIZE, &lmem_bytes));
+  if ((isa_flags & VX_ISA_EXT_TCU) == 0 || (isa_flags & VX_ISA_EXT_DXA) == 0)
+    reject("needs the TCU and DXA extensions");
+  if (NT != VX_CFG_NUM_THREADS)
+    reject("device warp size must match VX_CFG_NUM_THREADS");
+  if (issue_width * cfg::xtileM != 64)
+    reject("a tc.mma must cover 64 rows (4 TCU blocks)");
+
+  const uint32_t M = xm, N = xn, K = xk;
+  if (M < 1 || M > 64)
+    reject("M must be 1..64, the lanes of one tc.mma");
+  if (N % TILE_N != 0)
+    reject("N must be a multiple of TILE_N = " + std::to_string(TILE_N));
+  if (K % (KSTEPS * kStepK) != 0)
+    reject("K must be a multiple of KSTEPS * " + std::to_string(kStepK));
+  const uint32_t k_steps = K / kStepK;
+  const uint32_t num_tiles = N / TILE_N;
+  const uint32_t total_tiles = num_tiles * xP;
+  if (num_tiles < num_cores)
+    reject("N must give every core a tile: at least " + std::to_string(num_cores * TILE_N));
+  const uint32_t stage_a = ((KSTEPS - 1) * M * kStepRow + 64 * kStepRow + 127) / 128 * 128;
+  const uint32_t lmem_size = TMEM_SLOT_BYTES + PIPE * (stage_a + kStageW);
+  if (lmem_size > lmem_bytes)
+    reject("PIPE stages exceed the local memory");
+  // One persistent CTA per core: its two accumulator buffers take TMEM.
+  const uint32_t num_ctas = num_cores;
+  const uint32_t c_rows = (M + cfg::xtileM - 1) / cfg::xtileM * cfg::xtileM;
+  const uint32_t warps = STAGE_LOAD ? (LOAD_WARP0 + LOAD_WARPS) : CONSUME_WARPS ? (LOAD_WARP0 + CONSUME_WARPS) : LOAD_WARP0;
+  const double w_bytes = double(N) * K * sizeof(itype_t);
+  printf("GEMM_DECODE: M=%u N=%u K=%u tile_n=%u ksteps=%u pipe=%u xfer=%u xfers_per_stage=%u layout=%u "
+         "stage=%s warps=%u stage_bytes=%u lmem=%u tiles=%u ctas=%u cores=%u weight_bytes=%.0f\n",
+         M, N, K, TILE_N, KSTEPS, PIPE, XFER, kStageW / XFER, LAYOUT, STAGE_LOAD ? "load" : "dxa",
+         warps, stage_a + kStageW, lmem_size, num_tiles, num_ctas, (uint32_t)num_cores, w_bytes);
+
+  // A is packed by K step, [K/kstep][M][kstep]; W is the logical [K][N] in
+  // the device layout LAYOUT.
+  std::vector<itype_t> h_A(size_t(M) * K), h_W(size_t(K) * N);
+  for (auto& v : h_A) v = rv_ftoh_s(bit_cast<uint32_t>(float(rand()) / RAND_MAX), 0, nullptr);
+  for (auto& v : h_W) v = rv_ftoh_s(bit_cast<uint32_t>(float(rand()) / RAND_MAX), 0, nullptr);
+  std::vector<itype_t> h_Ap(h_A.size()), h_Wd(h_W.size());
+  for (uint32_t m = 0; m < M; ++m)
+    for (uint32_t k = 0; k < K; ++k)
+      h_Ap[(size_t(k / kStepK) * M + m) * kStepK + k % kStepK] = h_A[size_t(m) * K + k];
+  for (uint32_t k = 0; k < K; ++k) {
+    for (uint32_t n = 0; n < N; ++n) {
+      size_t idx;
+      if (LAYOUT == LAYOUT_PACKED)
+        idx = ((size_t(n / TILE_N) * k_steps + k / kStepK) * TILE_N + n % TILE_N) * kStepK + k % kStepK;
+      else if (LAYOUT == LAYOUT_KN)
+        idx = size_t(k) * N + n;
+      else
+        idx = size_t(n) * K + k;
+      h_Wd[idx] = h_W[size_t(k) * N + n];
+    }
+  }
+
+  if (xa) {
+    // The heap starts below the first 2 MB boundary, which the superpage heap
+    // (VORTEX_VM_MEGAPAGE_HEAP) maps with 4 KB pages; a GPU driver backs a
+    // large allocation with 2 MB pages throughout.
+    RT_CHECK(vx_buffer_create(device, 2u << 20, VX_MEM_READ, &pad_buffer));
+  }
+  RT_CHECK(vx_buffer_create(device, h_Ap.size() * sizeof(itype_t), VX_MEM_READ, &A_buffer));
+  RT_CHECK(vx_buffer_address(A_buffer, &kernel_arg.A_addr));
+  RT_CHECK(vx_buffer_create(device, h_Wd.size() * sizeof(itype_t), VX_MEM_READ, &W_buffer));
+  RT_CHECK(vx_buffer_address(W_buffer, &kernel_arg.W_addr));
+  RT_CHECK(vx_buffer_create(device, size_t(c_rows) * N * sizeof(float), VX_MEM_WRITE, &C_buffer));
+  RT_CHECK(vx_buffer_address(C_buffer, &kernel_arg.C_addr));
+  const uint32_t num_times = 4 * total_tiles + 2 * num_ctas;
+  RT_CHECK(vx_buffer_create(device, num_times * sizeof(uint64_t), VX_MEM_WRITE, &T_buffer));
+  RT_CHECK(vx_buffer_address(T_buffer, &kernel_arg.times_addr));
+  RT_CHECK(vx_enqueue_write(queue, A_buffer, 0, h_Ap.data(), h_Ap.size() * sizeof(itype_t), 0, nullptr, nullptr));
+  RT_CHECK(vx_enqueue_write(queue, W_buffer, 0, h_Wd.data(), h_Wd.size() * sizeof(itype_t), 0, nullptr, nullptr));
+
+  kernel_arg.M = M;
+  kernel_arg.N = N;
+  kernel_arg.K = K;
+  kernel_arg.passes = xP;
+
+  if (!STAGE_LOAD) {
+    // A: KSTEPS K steps of M rows, one contiguous run.
+    RT_CHECK(vortex::dxa::program_2d(device, 0, kernel_arg.A_addr,
+      /*size0=*/M * kStepK, /*size1=*/k_steps, /*stride0_bytes=*/M * kStepRow,
+      /*tile0=*/M * kStepK, /*tile1=*/KSTEPS, /*elem_bytes=*/sizeof(itype_t)));
+    // W: one transfer is XFER bytes of a stage, landing as rows of the K step.
+    if (LAYOUT == LAYOUT_PACKED) {
+      RT_CHECK(vortex::dxa::program_2d(device, 1, kernel_arg.W_addr,
+        /*size0=*/XFER / sizeof(itype_t), /*size1=*/uint32_t(w_bytes / XFER), /*stride0_bytes=*/XFER,
+        /*tile0=*/XFER / sizeof(itype_t), /*tile1=*/1, /*elem_bytes=*/sizeof(itype_t)));
+    } else if (LAYOUT == LAYOUT_NK16 || LAYOUT == LAYOUT_NK32) {
+      // (elements of a row, n, K step or pair): rows of 32 or 64 bytes.
+      const uint32_t row = (LAYOUT == LAYOUT_NK32) ? 2 * kStepK : kStepK;
+      RT_CHECK(vortex::dxa::program_3d(device, 1, kernel_arg.W_addr,
+        /*size0=*/row, /*size1=*/N, /*size2=*/K / row,
+        /*stride0_bytes=*/K * sizeof(itype_t), /*stride1_bytes=*/row * sizeof(itype_t),
+        /*tile0=*/row, /*tile1=*/XFER / (row * sizeof(itype_t)), /*tile2=*/1, /*elem_bytes=*/sizeof(itype_t)));
+    } else {
+      // W[K][N]: (n, k) tiles scattered K-major, n's K step 32 bytes apart.
+      RT_CHECK(vortex::dxa::program_2d(device, 1, kernel_arg.W_addr,
+        /*size0=*/N, /*size1=*/K, /*stride0_bytes=*/N * sizeof(itype_t),
+        /*tile0=*/XFER / kStepRow, /*tile1=*/kStepK, /*elem_bytes=*/sizeof(itype_t)));
+      RT_CHECK(vortex::dxa::set_layout(device, 1, vortex::dxa::Layout::KMajor, /*rank=*/2, sizeof(itype_t)));
+    }
+  }
+
+  RT_CHECK(vx_module_load_file(device, kernel_file, &module_));
+  RT_CHECK(vx_module_get_kernel(module_, "main", &kernel));
+
+  std::vector<float> h_C(size_t(c_rows) * N);
+  std::vector<uint64_t> h_T(num_times);
+
+  vx_launch_info_t li = {};
+  li.struct_size  = sizeof(li);
+  li.kernel       = kernel;
+  li.args_host    = &kernel_arg;
+  li.args_size    = sizeof(kernel_arg);
+  li.ndim         = 2;
+  li.grid_dim[0]  = num_ctas;
+  li.grid_dim[1]  = 1;
+  li.block_dim[0] = warps * NT;
+  li.block_dim[1] = 1;
+  li.lmem_size    = lmem_size;
+  li.tmem_cols    = 2 * TILE_N;
+
+  vx_event_h launch_ev = nullptr, read_ev = nullptr, t_ev = nullptr;
+  RT_CHECK(vx_enqueue_launch(queue, &li, 0, nullptr, &launch_ev));
+  RT_CHECK(vx_enqueue_read(queue, h_C.data(), C_buffer, 0, h_C.size() * sizeof(float), 1, &launch_ev, &read_ev));
+  RT_CHECK(vx_enqueue_read(queue, h_T.data(), T_buffer, 0, h_T.size() * sizeof(uint64_t), 1, &read_ev, &t_ev));
+  RT_CHECK(vx_event_wait_value(t_ev, 1, VX_TIMEOUT_INFINITE));
+  vx_event_release(t_ev);
+  vx_event_release(read_ev);
+  vx_event_release(launch_ev);
+
+  {
+    // The multiply phase of a tile runs from its first stage landing to its
+    // last multiply completing; per core the union of its tiles' phases.
+    // With several passes, also the passes after the first, which find W in the L2.
+    uint64_t first = UINT64_MAX, last = 0;
+    for (uint32_t c = 0; c < num_ctas; ++c) {
+      first = std::min(first, h_T[4 * total_tiles + 2 * c]);
+      last = std::max(last, h_T[4 * total_tiles + 2 * c + 1]);
+    }
+    auto union_cycles = [&](uint32_t t0) {
+      uint64_t mult = 0;
+      for (uint32_t core = 0; core < num_cores; ++core) {
+        std::vector<std::pair<uint64_t, uint64_t>> iv;
+        for (uint32_t t = t0; t < total_tiles; ++t) {
+          if (h_T[4 * t] == core)
+            iv.push_back({h_T[4 * t + 1], h_T[4 * t + 2]});
+        }
+        std::sort(iv.begin(), iv.end());
+        uint64_t lo = iv.empty() ? 0 : iv[0].first, hi = lo;
+        for (auto& p : iv) {
+          if (p.first > hi) {
+            mult += hi - lo;
+            lo = p.first;
+          }
+          hi = std::max(hi, p.second);
+        }
+        mult += hi - lo;
+      }
+      return mult;
+    };
+    uint64_t mult = union_cycles(0);
+    uint64_t span = last - first;
+    double bytes = w_bytes * xP;
+    double per_mult = bytes / mult, per_kernel = bytes / (double(num_cores) * span);
+    printf("DECODE_CYCLES: span=%lu multiply=%lu (summed over cores)\n", span, mult);
+    printf("DECODE_W_BYTES_PER_CLOCK_PER_SM: multiply=%.2f kernel=%.2f\n", per_mult, per_kernel);
+    printf("DECODE_W_GBS_PER_SM: multiply=%.1f kernel=%.1f total_kernel=%.1f (at %d MHz)\n",
+           per_mult * VX_CFG_PLATFORM_CLOCK_RATE / 1000.0, per_kernel * VX_CFG_PLATFORM_CLOCK_RATE / 1000.0,
+           bytes / span * VX_CFG_PLATFORM_CLOCK_RATE / 1000.0, VX_CFG_PLATFORM_CLOCK_RATE);
+    if (xP > 1) {
+      uint64_t later = union_cycles(num_tiles);
+      printf("DECODE_W_BYTES_PER_CLOCK_PER_SM_LATER_PASSES: multiply=%.2f\n", w_bytes * (xP - 1) / later);
+    }
+  }
+
+  int errors = 0;
+  uint32_t max_ulp = 0;
+  const uint32_t ulp_bound = float_ulp(K);
+#if defined(NO_MMA) || defined(READ_ONLY)
+  std::cout << "staging or reads only, C not checked" << std::endl;
+  if (false)
+#elif CONSUME_WARPS
+  {
+    // Each consumer thread's XOR of its words of every stage of its CTA's tiles.
+    constexpr uint32_t kT = CONSUME_WARPS * VX_CFG_NUM_THREADS;
+    const uint32_t stage_words = kStageW / 8, num_stages = k_steps / KSTEPS;
+    auto words = reinterpret_cast<const uint64_t*>(h_Wd.data());
+    std::vector<uint64_t> got(num_ctas * kT);
+    memcpy(got.data(), h_C.data(), got.size() * 8);  // the consumers' checksums, at the start of C
+    for (uint32_t c = 0; c < num_ctas; ++c) {
+      for (uint32_t t = 0; t < kT; ++t) {
+        uint64_t x = 0;
+        for (uint32_t tile = c; tile < total_tiles; tile += num_ctas)
+          for (uint32_t i = 0; i < num_stages; ++i) {
+            size_t base = (size_t((tile % num_tiles) * k_steps + i * KSTEPS) * TILE_N * kStepRow) / 8;
+            for (uint32_t j = t; j < stage_words; j += kT) x ^= words[base + j];
+          }
+        if (got[c * kT + t] != x) {
+          if (errors < MAX_ERRORS) printf("*** error: checksum cta=%u thread=%u\n", c, t);
+          ++errors;
+        }
+      }
+    }
+  }
+  if (false)
+#endif
+  {
+    std::vector<float> fW(h_W.size());
+    for (size_t i = 0; i < h_W.size(); ++i) fW[i] = bit_cast<float>(rv_htof_s(h_W[i], 0, nullptr));
+    std::vector<double> acc(N);
+    for (uint32_t m = 0; m < M; ++m) {
+      std::fill(acc.begin(), acc.end(), 0.0);
+      for (uint32_t k = 0; k < K; ++k) {
+        double a = bit_cast<float>(rv_htof_s(h_A[size_t(m) * K + k], 0, nullptr));
+        const float* pW = &fW[size_t(k) * N];
+        for (uint32_t n = 0; n < N; ++n)
+          acc[n] += a * pW[n];
+      }
+      for (uint32_t n = 0; n < N; ++n) {
+        float expected = float(acc[n]);
+        float actual = h_C[size_t(m) * N + n];
+        int32_t d = std::abs(bit_cast<int32_t>(actual) - bit_cast<int32_t>(expected));
+        max_ulp = std::max<uint32_t>(max_ulp, d);
+        if (d > (int32_t)ulp_bound) {
+          if (errors < MAX_ERRORS)
+            printf("*** error: [%u,%u] expected=%f, actual=%f\n", m, n, expected, actual);
+          ++errors;
+        }
+      }
+    }
+  }
+  printf("reference drift: max=%u ULP, bound=%u ULP (K=%u)\n", max_ulp, ulp_bound, K);
+
+  cleanup();
+
+  if (errors != 0) {
+    std::cout << "Found " << errors << " / " << size_t(M) * N << " errors!" << std::endl;
+    std::cout << "FAILED!" << std::endl;
+    return 1;
+  }
+  std::cout << "PASSED!" << std::endl;
+  return 0;
+}
