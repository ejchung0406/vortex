+#ifdef PATH_STATS
+// Measurement only: per arbiter output, cycles a request (or response) was
+// passed, and cycles one waited because the next stage refused it.
+struct PathStats {
+  std::string name;
+  std::vector<uint64_t> sent, refused;
+  static std::vector<PathStats*>& registry() {
+    static std::vector<PathStats*> reg;
+    static bool hooked = (std::atexit([] {
+      for (auto* p : registry()) {
+        uint64_t s = 0, r = 0;
+        for (auto v : p->sent) s += v;
+        for (auto v : p->refused) r += v;
+        if (s == 0 && r == 0) continue;
+        std::cout << "PATH: " << p->name << " sent=";
+        for (size_t i = 0; i < p->sent.size(); ++i) std::cout << (i ? "," : "") << p->sent[i];
+        std::cout << " refused=";
+        for (size_t i = 0; i < p->refused.size(); ++i) std::cout << (i ? "," : "") << p->refused[i];
+        std::cout << std::endl;
+      }
+    }), true);
+    (void)hooked;
+    return reg;
+  }
+  PathStats* init(const std::string& n, size_t outs) {
+    name = n; sent.assign(outs, 0); refused.assign(outs, 0);
+    registry().push_back(this);
+    return this;
+  }
+};
+#endif
