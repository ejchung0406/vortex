 using namespace vortex;
 
+// DEBUG(m16): VX_MEMCHK=1 checks every global load of a thread against that
+// thread's own earlier stores in program order (order of address generation in
+// the LSU). A byte last written by another thread, an AMO, or never written by
+// the kernel is not checked.
+#include <unordered_map>
+#include <map>
+#include <cstdlib>
+namespace {
+struct MemByte { uint8_t v; uint32_t owner; uint64_t cyc; };
+struct MemExp { uint64_t addr; uint64_t val; uint8_t mask; uint64_t ld_cyc; uint64_t pc; uint32_t wid; };
+struct MemChk {
+  bool on = (getenv("VX_MEMCHK") != nullptr);
+  std::unordered_map<uint64_t, MemByte> mem;
+  std::map<std::pair<uint64_t,uint32_t>, MemExp> exp;
+  uint64_t checked = 0, bad = 0, stack_checked = 0, stack_bad = 0;
+  ~MemChk() { if (on) std::cout << "MEMCHK: checked=" << checked << " bad=" << bad
+                                << " (stack: checked=" << stack_checked << " bad=" << stack_bad << ")" << std::endl; }
+};
+MemChk g_mc;
+inline uint32_t mc_owner(uint32_t wid, uint32_t tid) { return (wid << 8) | tid; }
+}
