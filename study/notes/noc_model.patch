+#pragma once
+
+#include <algorithm>
+#include <cstdint>
+#include <vector>
+#include "types.h"
+
+namespace vortex {
+
+// An SM group's uplink to the L2. Together its ports pass at most
+// `bytes_per_cycle` bytes of lines a cycle, counted on one side: on the return
+// side (every response costs a line, requests pass free) or on the request side
+// (every request costs a line, responses pass free). On the H200 the per-GPC
+// limit is the same for DRAM and L2-resident data and for local or remote
+// pages, so it counts unique lines; and a saturated GPC slows SMs in other
+// GPCs, which a return-side limit does when its backlog waits in the L2 banks'
+// shared response queues and a request-side one does not. The credit grows by
+// bytes_per_cycle a cycle up to one line per port beyond it, so the long-run
+// rate is exact and a burst after an idle spell is at most one line per port.
+// Ports take turns round-robin from where the last cycle's grants ended; a
+// port passes at most one packet a cycle each way, a cycle after its grant.
+class NocUplink : public SimObject<NocUplink> {
+public:
+  using Ptr = std::shared_ptr<NocUplink>;
+
+  std::vector<SimChannel<MemReq>> ReqIn;
+  std::vector<SimChannel<MemReq>> ReqOut;
+  std::vector<SimChannel<MemRsp>> RspIn;
+  std::vector<SimChannel<MemRsp>> RspOut;
+
+  NocUplink(const SimContext& ctx, const char* name, uint32_t ports,
+            uint32_t bytes_per_cycle, uint32_t line_size, bool request_side)
+    : SimObject<NocUplink>(ctx, name)
+    , ReqIn(ports, this)
+    , ReqOut(ports, this)
+    , RspIn(ports, this)
+    , RspOut(ports, this)
+    , rate_(bytes_per_cycle)
+    , line_(line_size)
+    , cap_(uint64_t(bytes_per_cycle) + uint64_t(ports) * line_size)
+    , request_side_(request_side) {
+    __assert(bytes_per_cycle != 0, "an uplink gate needs a rate");
+  }
+
+protected:
+  void on_reset() {
+    credit_ = cap_;
+    req_rr_ = rsp_rr_ = 0;
+    last_cycle_ = 0;
+  }
+
+  void on_tick() {
+    uint64_t now = SimPlatform::instance().cycles();
+    credit_ = std::min<uint64_t>(cap_, credit_ + (now - last_cycle_) * rate_);
+    last_cycle_ = now;
+
+    uint32_t P = ReqIn.size();
+    uint32_t req_cost = request_side_ ? line_ : 0;
+    uint32_t rsp_cost = request_side_ ? 0 : line_;
+    uint32_t start = req_rr_;
+    for (uint32_t k = 0; k < P && credit_ >= req_cost; ++k) {
+      uint32_t p = (start + k) % P;
+      auto& in = ReqIn.at(p);
+      if (in.empty())
+        continue;
+      if (ReqOut.at(p).try_send(in.peek(), 1)) {
+        in.pop();
+        credit_ -= req_cost;
+        req_rr_ = (p + 1) % P;
+      }
+    }
+    start = rsp_rr_;
+    for (uint32_t k = 0; k < P && credit_ >= rsp_cost; ++k) {
+      uint32_t p = (start + k) % P;
+      auto& in = RspIn.at(p);
+      if (in.empty())
+        continue;
+      if (RspOut.at(p).try_send(in.peek(), 1)) {
+        in.pop();
+        credit_ -= rsp_cost;
+        rsp_rr_ = (p + 1) % P;
+      }
+    }
+
+    // size() counts packets still on their way in: their send already woke us.
+    bool idle = true;
+    for (uint32_t p = 0; p < P; ++p) {
+      idle &= (ReqIn.at(p).size() == 0) && (RspIn.at(p).size() == 0);
+    }
+    if (idle) {
+      this->tick_sleep();
+    }
+  }
+
+private:
+  uint32_t rate_;
+  uint32_t line_;
+  uint64_t cap_;
+  bool request_side_;
+  uint64_t credit_ = 0;
+  uint32_t req_rr_ = 0;
+  uint32_t rsp_rr_ = 0;
+  uint64_t last_cycle_ = 0;
+
+  friend class SimObject<NocUplink>;
+};
+
