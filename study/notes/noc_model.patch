+#include "types.h"
+
+namespace vortex {
+
+// Keeps a socket port's flush tokens (fences) in order with its other requests
+// across an SM group's address-hashed uplink lanes. The L2 serves a token when
+// it heads the input it arrived on and holds every input's cacheable requests
+// meanwhile; with one private link per port that orders the token behind the
+// port's earlier requests and ahead of its later ones. Across lanes it does
+// not, so each port counts its requests between here and the L2: a token waits
+// until the port has none left in flight, and the port's later requests wait
+// until the token has reached the L2. Requests of one address share a lane, so
+// same-address order (atomics, LR/SC, a load behind a store) holds without this.
+class NocPortOrder : public SimObject<NocPortOrder> {
+public:
+  using Ptr = std::shared_ptr<NocPortOrder>;
+
+  std::vector<SimChannel<MemReq>>   ReqIn;
+  std::vector<SimChannel<MemReq>>   ReqOut;
+  // one per lane: the switch input index of each request that reached the L2
+  std::vector<SimChannel<uint32_t>> Delivered;
+
+  NocPortOrder(const SimContext& ctx, const char* name, uint32_t ports, uint32_t lanes)
+    : SimObject<NocPortOrder>(ctx, name)
+    , ReqIn(ports, this)
+    , ReqOut(ports, this)
+    , Delivered(lanes, this)
+    , in_flight_(ports, 0)
+    , token_out_(ports, false)
+  {}
+
+protected:
+  void on_reset() {
+    std::fill(in_flight_.begin(), in_flight_.end(), 0);
+    std::fill(token_out_.begin(), token_out_.end(), false);
+  }
+
+  void on_tick() {
+    for (auto& d : Delivered) {
+      while (!d.empty()) {
+        uint32_t p = d.peek();
+        d.pop();
+        __assert(in_flight_.at(p) != 0, "a delivery the port did not send");
+        if (--in_flight_.at(p) == 0) {
+          token_out_.at(p) = false;
+        }
+      }
+    }
+    bool busy = false;
+    for (uint32_t p = 0, n = ReqIn.size(); p < n; ++p) {
+      auto& in = ReqIn.at(p);
+      busy |= (in.size() != 0) || (in_flight_.at(p) != 0);
+      if (in.empty() || token_out_.at(p))
+        continue;
+      bool token = in.peek().flags.flush;
+      if (token && in_flight_.at(p) != 0)
+        continue;
+      if (ReqOut.at(p).try_send(in.peek(), 1)) {
+        in.pop();
+        ++in_flight_.at(p);
+        token_out_.at(p) = token;
+      }
+    }
+    if (!busy) {
+      this->tick_sleep();
+    }
+  }
+
+private:
+  std::vector<uint32_t> in_flight_;
+  std::vector<bool>     token_out_;
+
+  friend class SimObject<NocPortOrder>;
+};
+
+// Last stage of an uplink lane before the L2: passes each request on and
+// reports the switch input it came from (the low tag bits the switch added).
+class NocLaneTap : public SimObject<NocLaneTap> {
+public:
+  using Ptr = std::shared_ptr<NocLaneTap>;
+
+  SimChannel<MemReq>   In;
+  SimChannel<MemReq>   Out;
+  SimChannel<uint32_t> Delivered;
+
+  NocLaneTap(const SimContext& ctx, const char* name, uint32_t input_bits)
+    : SimObject<NocLaneTap>(ctx, name)
+    , In(this)
+    , Out(this)
+    , Delivered(this)
+    , mask_((1u << input_bits) - 1)
+  {}
+
+protected:
+  void on_reset() {}
+
+  void on_tick() {
+    if (!In.empty() && Out.try_send(In.peek(), 1)) {
+      Delivered.send(In.peek().tag & mask_, 1);
+      In.pop();
+    }
+    if (In.size() == 0) {
+      this->tick_sleep();
+    }
+  }
+
+private:
+  uint32_t mask_;
+
+  friend class SimObject<NocLaneTap>;
+};
+
