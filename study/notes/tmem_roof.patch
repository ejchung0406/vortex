+++ src_tmem/tests/regression/flashattention4/common.h	2026-11-21 00:01:53.006527174 -0500
@@ -0,0 +1,43 @@
+#ifndef _FLASHATTENTION4_TMEM_COMMON_H_
+#define _FLASHATTENTION4_TMEM_COMMON_H_
+
+#include <stdint.h>
+
+#ifndef WGMMA_NRC
+  #define WGMMA_NRC 32
+#endif
+
+#ifndef ITYPE
+  #define ITYPE fp16
+#endif
+
+#ifndef OTYPE
+  #define OTYPE fp32
+#endif
+
+// Shared-memory pipeline stages.
+#ifndef PIPE_N
+  #define PIPE_N 2
+#endif
+
+// K-tiles per pipeline stage, one tc.mma each.
+#ifndef KB
+  #define KB 4
+#endif
+
+// Control warps per CTA: a producer warp stages the operands and an MMA warp
+// issues tc.mma and tc.commit.
+#define CTRL_WARPS 2
+
+// One head over NB KV blocks of L keys: Q is [M][D], K_T is [NB*L][D], V_T is [N][NB*L].
+// Shared memory starts with the CTA's TMEM column, padded to keep the stages aligned.
+#define TMEM_SLOT_BYTES 64
+
+typedef struct {
+  uint32_t L, N, D, NB;
+  float scale;
+  uint32_t pad;
+  uint64_t O_addr;
+} kernel_arg_t;
+
+#endif
diff -ruN '--exclude=third_party' '--exclude=*.o' '--exclude=.git' src_war/tests/regression/flashattention4/kernel.cpp src_tmem/tests/regression/flashattention4/kernel.cpp
--- src_war/tests/regression/flashattention4/kernel.cpp	1969-12-31 19:00:00.000000000 -0500
+++ src_tmem/tests/regression/flashattention4/kernel.cpp	2026-11-21 00:01:53.017835860 -0500
@@ -0,0 +1,300 @@
+#include "common.h"
+#include <vx_spawn2.h>
+#include <vx_tensor.h>
+#include <vx_tmem.h>
+#include <vx_intrinsics.h>
+#include <vx_dxa.h>
+#include <vx_barrier.h>
+#include <vx_tfu.h>
+
+namespace vt = vortex::tensor;
+namespace tm = vortex::tmem;
+using ctx = vt::wgmma_context<VX_CFG_NUM_THREADS, vt::ITYPE, vt::OTYPE, false, WGMMA_NRC>;
+using wg_cfg = vt::wgmma_config_t<VX_CFG_NUM_THREADS, vt::ITYPE, vt::OTYPE, WGMMA_NRC>;
+
+constexpr uint32_t kDescQ  = 0;
+constexpr uint32_t kDescKT = 1;
+constexpr uint32_t kDescVT = 2;
+
+constexpr uint32_t kPipeN = PIPE_N;
+constexpr uint32_t kBK    = KB * ctx::tileK;  // K per stage
+static_assert(VX_CFG_NUM_THREADS == ctx::xtileM, "one column per register");
+
+// tmem.ld/st use fixed registers f0.., so the softmax moves 8 columns at a time
+// to leave the rest of the FP registers to the compiler.
+struct frag8_t {
+  static constexpr uint32_t NR = 8;
+  float data[NR];
+};
+constexpr uint32_t kNR = frag8_t::NR;
+
+// The control warps (CTRL_WARPS) stage the operands and issue tc.mma; each of
+// the two Q tiles has a softmax group of one warp per TCU block, so an MMA's M
+// rows are the group's TMEM lanes.
+constexpr uint32_t kTiles      = 2;
+constexpr uint32_t kGroupWarps = VX_CFG_NUM_TCU_BLOCKS;
+constexpr uint32_t kTileM      = kGroupWarps * ctx::xtileM;
+constexpr uint32_t kTileCols   = 128;  // S, P and O of a tile
+constexpr uint32_t kWarps      = CTRL_WARPS + kTiles * kGroupWarps;
+
+// Stages (full, empty), then per tile: its MMAs done, its softmax done.
+constexpr uint32_t kBarDone = 2 * kPipeN;
+constexpr uint32_t kBarSm   = kBarDone + kTiles;
+static_assert(kBarSm + kTiles <= VX_CFG_NUM_BARRIERS, "not enough barriers");
+
+// P's fp16 conversion needs a normal input; attention below this weight is negligible.
+constexpr float kPMin = 6.2e-5f;
+// Softmax runs in base 2. O is rescaled only once a row maximum has grown by
+// more than log2(256); until then P is relative to the stale maximum and stays
+// below 256.
+constexpr float kLog2e      = 1.44269504088896341f;
+constexpr float kRescaleTau = 8.0f;
+
+static inline float fmax32(float a, float b) {
+  float r;
+  __asm__ volatile ("fmax.s %0, %1, %2" : "=f"(r) : "f"(a), "f"(b));
+  return r;
+}
+
+static inline float max8(const float* v) {
+  float a = fmax32(fmax32(v[0], v[1]), fmax32(v[2], v[3]));
+  float b = fmax32(fmax32(v[4], v[5]), fmax32(v[6], v[7]));
+  return fmax32(a, b);
+}
+
+// fp32 -> fp16 bits for a positive normal fp16 value, rounding half up.
+static inline uint32_t f32_to_f16_pos(float x) {
+  uint32_t b;
+  __builtin_memcpy(&b, &x, 4);
+  return ((b + 0x1000u) >> 13) - 0x1C000u;
+}
+
+// Per stage of K: wait for it, multiply, and commit it back.
+// One tc.mma per K step: a stage holds KB K-tiles of k_steps steps each.
+static inline __attribute__((always_inline)) void mma_steps(
+    uint32_t& i, uint32_t K, uint32_t cta_id, bool acc_init, uint32_t taddr, uint32_t n_frag,
+    uint32_t a_col, bool a_tmem, uint32_t smem_base, uint32_t stage_bytes, uint32_t b_off) {
+  constexpr uint32_t kSteps = KB * wg_cfg::k_steps;
+  constexpr uint32_t kKtBytes = wg_cfg::fedpK * 4;
+  constexpr uint32_t kLd = kBK * sizeof(ctx::input_t);
+  for (uint32_t k = 0; k < K; k += kBK, ++i) {
+    const uint32_t s = i % kPipeN;
+    const uint32_t full = cta_id | (s << 8);
+    int phase = vx_barrier_arrive(full, 2);
+    vx_barrier_wait(full, phase);
+    const uint32_t a_off = smem_base + s * stage_bytes;
+    const uint32_t b_base = a_off + b_off;
+    for (uint32_t kt = 0; kt < kSteps; ++kt) {
+      const uint32_t gk = (k / kBK) * kSteps + kt;
+      const auto idesc = tm::make_idesc<vt::ITYPE>(n_frag, taddr, acc_init && gk == 0);
+      const auto b = tm::smem_desc(b_base + kt * kKtBytes, kLd);
+      if (a_tmem) {
+        tm::mma(idesc, tm::tmem_col{a_col + gk * wg_cfg::fedpK}, b);
+      } else {
+        tm::mma(idesc, tm::smem_desc(a_off + kt * kKtBytes, kLd), b);
+      }
+    }
+    tm::commit(cta_id | ((kPipeN + s) << 8), 2);
+  }
+}
+
+static inline __attribute__((always_inline)) void wait_empty(uint32_t i, uint32_t cta_id) {
+  if (i >= kPipeN) {
+    uint32_t e = cta_id | ((kPipeN + i % kPipeN) << 8);
+    int phase = vx_barrier_arrive(e, 2);
+    vx_barrier_wait(e, phase);
+  }
+}
+
+// S stages: Q rows [q_row, +kTileM) and K_T rows [kv_row, +L), over D.
+static inline __attribute__((always_inline)) void load_s(
+    uint32_t& i, uint32_t D, uint32_t cta_id, ctx::input_t* smem, uint32_t stage_elems,
+    uint32_t q_row, uint32_t kv_row) {
+  for (uint32_t k = 0; k < D; k += kBK, ++i) {
+    wait_empty(i, cta_id);
+    const uint32_t s = i % kPipeN;
+    const uint32_t full = cta_id | (s << 8);
+    auto stage = smem + s * stage_elems;
+    vx_barrier_expect_tx(full, 2);
+    vx_dxa_issue_2d_wg(kDescQ, full, stage, k, q_row);
+    vx_dxa_issue_2d_wg(kDescKT, full, stage + kTileM * kBK, k, kv_row);
+    vx_barrier_arrive(full, 2);
+  }
+}
+
+// P.V stages: V_T columns [kv_col, +L).
+static inline __attribute__((always_inline)) void load_pv(
+    uint32_t& i, uint32_t L, uint32_t cta_id, ctx::input_t* smem, uint32_t stage_elems, uint32_t kv_col) {
+  for (uint32_t k = 0; k < L; k += kBK, ++i) {
+    wait_empty(i, cta_id);
+    const uint32_t s = i % kPipeN;
+    const uint32_t full = cta_id | (s << 8);
+    vx_barrier_expect_tx(full, 1);
+    vx_dxa_issue_2d_wg(kDescVT, full, smem + s * stage_elems, kv_col + k, 0);
+    vx_barrier_arrive(full, 2);
+  }
+}
+
+__kernel void kernel_main(kernel_arg_t* __UNIFORM__ arg) {
+  const uint32_t L = arg->L, N = arg->N, D = arg->D, NB = arg->NB;
+  const float scale = arg->scale;
+  auto pO = reinterpret_cast<ctx::output_t*>(arg->O_addr);
+
+  const uint32_t warp_rank = threadIdx.x / VX_CFG_NUM_THREADS;
+  const uint32_t t = vx_thread_id();
+
+  auto lmem = reinterpret_cast<uint8_t*>(__local_mem());
+  auto tmem_slot = reinterpret_cast<volatile uint32_t*>(lmem);
+  auto smem = reinterpret_cast<ctx::input_t*>(lmem + TMEM_SLOT_BYTES);
+  const uint32_t cta_row = blockIdx.x * kTiles * kTileM;
+
+  const uint32_t cta_id = get_local_group_id();
+  auto bar = [&](uint32_t n) { return cta_id | (n << 8); };
+
+  // Every warp meets on the first softmax barrier before its first use, to
+  // share the TMEM columns and, at the end, to free them.
+  const uint32_t all_bar = bar(kBarSm);
+  if (warp_rank == 0) {
+    // Every thread holds the same column; a store per thread avoids a divergent branch.
+    *tmem_slot = tm::alloc(kTiles * kTileCols);
+  }
+  vx_barrier(all_bar, kWarps);
+  const uint32_t col_base = *tmem_slot;
+  auto s_col = [&](uint32_t tile) { return col_base + tile * kTileCols; };
+  auto p_col = [&](uint32_t tile) { return s_col(tile) + L; };
+  auto o_col = [&](uint32_t tile) { return p_col(tile) + L / 2; };
+
+  // Both MMAs share one stage ring: S = Q.K_T stages A (Q) then B (K_T), and
+  // O += P.V stages only B (V_T), as P is in TMEM.
+  const uint32_t stage_elems = kTileM * kBK + kBK * (L > N ? L : N);
+  const uint32_t smem_base   = tm::smem_offset(smem);
+  const uint32_t q_bytes     = kTileM * kBK * sizeof(ctx::input_t);
+  const uint32_t stage_bytes = stage_elems * sizeof(ctx::input_t);
+
+  // MMAs in issue order. Ping-pong: while one tile's softmax runs, the TCU
+  // works on the other's. The steps take plain values so the per-K-tile code
+  // stays in registers across the asm memory clobbers.
+  if (warp_rank == 0) {
+    // Producer: it and the MMA warp are the two participants of every full and
+    // empty barrier. Loads run ahead of the softmax, bounded by the ring.
+    const uint32_t q_row = cta_row;
+    uint32_t i = 0;
+    for (uint32_t tile = 0; tile < kTiles; ++tile) {
+      load_s(i, D, cta_id, smem, stage_elems, q_row + tile * kTileM, 0);
+    }
+    for (uint32_t b = 0; b < NB; ++b) {
+      for (uint32_t tile = 0; tile < kTiles; ++tile) {
+        load_pv(i, L, cta_id, smem, stage_elems, b * L);
+        if (b + 1 < NB) {
+          load_s(i, D, cta_id, smem, stage_elems, q_row + tile * kTileM, (b + 1) * L);
+        }
+      }
+    }
+    // Close the last generation of every empty barrier the MMA warp committed.
+    for (uint32_t j = (i > kPipeN) ? (i - kPipeN) : 0; j < i; ++j) {
+      uint32_t e = cta_id | ((kPipeN + j % kPipeN) << 8);
+      int phase = vx_barrier_arrive(e, 2);
+      vx_barrier_wait(e, phase);
+    }
+    vx_barrier(all_bar, kWarps);
+    tm::dealloc(col_base, kTiles * kTileCols);
+    return;
+  }
+  if (warp_rank == 1) {
+    // A tile's softmax waits on the commit after its S MMA (or its last P.V).
+    uint32_t i = 0;
+    for (uint32_t tile = 0; tile < kTiles; ++tile) {
+      mma_steps(i, D, cta_id, true, s_col(tile), L / ctx::tcN, 0, false, smem_base, stage_bytes, q_bytes);
+      tm::commit(bar(kBarDone + tile), 1 + kGroupWarps);
+    }
+    for (uint32_t b = 0; b < NB; ++b) {
+      for (uint32_t tile = 0; tile < kTiles; ++tile) {
+        vx_barrier(bar(kBarSm + tile), 1 + kGroupWarps);
+        mma_steps(i, L, cta_id, b == 0, o_col(tile), N / ctx::tcN, p_col(tile), true, smem_base, stage_bytes, 0);
+        if (b + 1 < NB) {
+          mma_steps(i, D, cta_id, true, s_col(tile), L / ctx::tcN, 0, false, smem_base, stage_bytes, q_bytes);
+        }
+        tm::commit(bar(kBarDone + tile), 1 + kGroupWarps);
+      }
+    }
+    vx_barrier(all_bar, kWarps);
+    return;
+  }
+
+  const uint32_t tile = (warp_rank - CTRL_WARPS) / kGroupWarps;
+  // A softmax group's warps are one per TCU block; each reaches its own block's lanes.
+  const uint32_t lane = tm::warp_lane();
+  const uint32_t done_bar = bar(kBarDone + tile);
+  const uint32_t sm_bar   = bar(kBarSm + tile);
+
+  // The scale is positive, so the row maximum of S scales with it.
+  const float scale2 = scale * kLog2e;
+  float row_max = 0.0f;
+  float row_sum = 0.0f;
+
+  for (uint32_t b = 0; b < NB; ++b) {
+    // S of block b, and O through block b - 1.
+    vx_barrier(done_bar, 1 + kGroupWarps);
+
+    float smax = -3.0e38f;
+    for (uint32_t c = 0; c < L / kNR; ++c) {
+      frag8_t s;
+      tm::load<tm::LANE_PER_THREAD>(s, tm::make_taddr(lane, s_col(tile) + c * kNR));
+      smax = fmax32(smax, max8(s.data));
+    }
+    const float cand = (b == 0) ? smax * scale2 : fmax32(row_max, smax * scale2);
+    if (b == 0) {
+      row_max = cand;
+    } else if (vx_vote_any(cand - row_max > kRescaleTau)) {
+      const float rescale = vx_ex2f(row_max - cand);
+      row_max = cand;
+      row_sum *= rescale;
+      for (uint32_t c = 0; c < N / kNR; ++c) {
+        frag8_t o;
+        uint32_t taddr = tm::make_taddr(lane, o_col(tile) + c * kNR);
+        tm::load<tm::LANE_PER_THREAD>(o, taddr);
+        #pragma unroll
+        for (uint32_t r = 0; r < kNR; ++r) {
+          o.data[r] *= rescale;
+        }
+        tm::store<tm::LANE_PER_THREAD>(taddr, o);
+      }
+    }
+
+    // P = exp(S - max) as fp16, K-packed for the P.V MMA.
+    for (uint32_t c = 0; c < L / (2 * kNR); ++c) {
+      frag8_t s0, s1, p;
+      uint32_t col = s_col(tile) + c * 2 * kNR;
+      tm::load<tm::LANE_PER_THREAD>(s0, tm::make_taddr(lane, col));
+      tm::load<tm::LANE_PER_THREAD>(s1, tm::make_taddr(lane, col + kNR));
+      float psum[kNR / 2] = {};
+      #pragma unroll
+      for (uint32_t r = 0; r < kNR; ++r) {
+        float lo = (r < kNR / 2) ? s0.data[2 * r] : s1.data[2 * r - kNR];
+        float hi = (r < kNR / 2) ? s0.data[2 * r + 1] : s1.data[2 * r + 1 - kNR];
+        lo = fmax32(vx_ex2f(lo * scale2 - row_max), kPMin);
+        hi = fmax32(vx_ex2f(hi * scale2 - row_max), kPMin);
+        psum[r % (kNR / 2)] += lo + hi;
+        uint32_t word = f32_to_f16_pos(lo) | (f32_to_f16_pos(hi) << 16);
+        __builtin_memcpy(&p.data[r], &word, 4);
+      }
+      tm::store<tm::LANE_PER_THREAD>(tm::make_taddr(lane, p_col(tile) + c * kNR), p);
+      row_sum += (psum[0] + psum[1]) + (psum[2] + psum[3]);
+    }
+    tm::wait_st();
+    vx_barrier_arrive(sm_bar, 1 + kGroupWarps);
+  }
+
+  vx_barrier(done_bar, 1 + kGroupWarps);
+  const float inv_sum = vx_rcpf(row_sum);
+  const uint32_t row = cta_row + tile * kTileM + lane + t;
+  for (uint32_t c = 0; c < N / kNR; ++c) {
+    frag8_t o;
+    tm::load<tm::LANE_PER_THREAD>(o, tm::make_taddr(lane, o_col(tile) + c * kNR));
+    #pragma unroll
+    for (uint32_t r = 0; r < kNR; ++r) {
+      pO[row * N + c * kNR + r] = o.data[r] * inv_sum;
+    }
+  }
+  vx_barrier(all_bar, kWarps);
+}
diff -ruN '--exclude=third_party' '--exclude=*.o' '--exclude=.git' src_war/tests/regression/flashattention4/main.cpp src_tmem/tests/regression/flashattention4/main.cpp
--- src_war/tests/regression/flashattention4/main.cpp	1969-12-31 19:00:00.000000000 -0500
+++ src_tmem/tests/regression/flashattention4/main.cpp	2026-11-21 00:01:53.026034701 -0500
@@ -0,0 +1,202 @@
+#include "common.h"
+#include <algorithm>
+#include <cmath>
+#include <iostream>
+#include <rvfloats.h>
+#include <tensor_cfg.h>
+#include <unistd.h>
+#include <util.h>
+#include <vector>
+#include <vortex2.h>
+#include <dxa.h>
+
+#define RT_CHECK(_expr)                                      \
+  do {                                                       \
+    int _ret = _expr;                                        \
+    if (0 == _ret)                                           \
+      break;                                                 \
+    printf("Error: '%s' returned %d!\n", #_expr, (int)_ret); \
+    cleanup();                                               \
+    exit(-1);                                                \
+  } while (false)
+
+using namespace vortex;
+namespace vt = tensor;
+using cfg = vt::wgmma_config_t<VX_CFG_NUM_THREADS, vt::ITYPE, vt::OTYPE, WGMMA_NRC>;
+
+static_assert(std::is_same<vt::ITYPE, vt::fp16>::value && std::is_same<vt::OTYPE, vt::fp32>::value,
+              "P is fp16 and S, O are fp32");
+
+uint32_t xl = 64;
+uint32_t xn = 32;
+uint32_t xd = 64;
+uint32_t xb = 2;
+uint32_t xc = 1;
+
+// fp16 rounding of P and TFU's approximations.
+constexpr double kMaxRelError = 0.01;
+
+vx_device_h device = nullptr;
+vx_buffer_h buffers[4] = {};
+vx_queue_h  queue = nullptr;
+vx_module_h module_ = nullptr;
+vx_kernel_h kernel = nullptr;
+kernel_arg_t kernel_arg = {};
+
+void cleanup() {
+  if (device) {
+    for (auto b : buffers) {
+      if (b) vx_buffer_release(b);
+    }
+    if (kernel) vx_kernel_release(kernel);
+    if (module_) vx_module_release(module_);
+    if (queue) vx_queue_release(queue);
+    vx_device_dump_perf(device, stdout);
+    vx_device_release(device);
+  }
+}
+
+static uint16_t gen_fp16() {
+  auto f = float(rand()) / RAND_MAX;
+  return rv_ftoh_s(bit_cast<uint32_t>(f), 0, nullptr);
+}
+
+static double htod(uint16_t h) {
+  return bit_cast<float>(rv_htof_s(h, 0, nullptr));
+}
+
+int main(int argc, char* argv[]) {
+  int c;
+  while ((c = getopt(argc, argv, "l:n:d:b:c:")) != -1) {
+    switch (c) {
+    case 'l': xl = atoi(optarg); break;
+    case 'n': xn = atoi(optarg); break;
+    case 'd': xd = atoi(optarg); break;
+    case 'b': xb = atoi(optarg); break;
+    case 'c': xc = atoi(optarg); break;
+    default: return -1;
+    }
+  }
+
+  srand(50);
+  RT_CHECK(vx_device_open(0, &device));
+  vx_queue_info_t qi = { sizeof(qi), nullptr, VX_QUEUE_PRIORITY_NORMAL, 0 };
+  RT_CHECK(vx_queue_create(device, &qi, &queue));
+
+  uint64_t NT, issue_width;
+  RT_CHECK(vx_device_query(device, VX_CAPS_NUM_THREADS, &NT));
+  RT_CHECK(vx_device_query(device, VX_CAPS_ISSUE_WIDTH, &issue_width));
+
+  // Per CTA: the control warps and, for each of two Q tiles, one softmax warp per TCU block.
+  const uint32_t tile_m = issue_width * cfg::xtileM;
+  const uint32_t warps = CTRL_WARPS + 2 * issue_width;
+  const uint32_t MT = 2 * tile_m * xc;
+  const uint32_t L = xl, N = xn, D = xd, NB = xb, LT = L * NB;
+  const uint32_t nr = WGMMA_NRC;
+  const uint32_t stage_k = KB * cfg::tileK;
+  if ((L % (2 * nr)) || (N % nr) || (D % stage_k) || (L % stage_k) || (L + L / 2 + N > 128)) {
+    std::cout << "Error: L must be a multiple of " << 2 * nr << ", N of " << nr
+              << ", D and L of KB*tileK=" << stage_k << ", and L + L/2 + N <= 128" << std::endl;
+    return -1;
+  }
+
+  // K_T and V_T are the K-major forms.
+  std::vector<uint16_t> h_Q(size_t(MT) * D), h_KT(size_t(LT) * D), h_VT(size_t(N) * LT);
+  for (auto& x : h_Q) x = gen_fp16();
+  for (auto& x : h_KT) x = gen_fp16();
+  for (auto& x : h_VT) x = gen_fp16();
+
+  uint32_t smem_size = PIPE_N * (tile_m * stage_k + stage_k * std::max(L, N)) * sizeof(uint16_t);
+  smem_size += TMEM_SLOT_BYTES;
+
+  kernel_arg.L = L; kernel_arg.N = N; kernel_arg.D = D; kernel_arg.NB = NB;
+  kernel_arg.scale = 1.0f / std::sqrt(float(D));
+  uint64_t q_addr, kt_addr, vt_addr;
+  RT_CHECK(vx_buffer_create(device, h_Q.size() * 2, VX_MEM_READ, &buffers[0]));
+  RT_CHECK(vx_buffer_create(device, h_KT.size() * 2, VX_MEM_READ, &buffers[1]));
+  RT_CHECK(vx_buffer_create(device, h_VT.size() * 2, VX_MEM_READ, &buffers[2]));
+  RT_CHECK(vx_buffer_create(device, size_t(MT) * N * 4, VX_MEM_WRITE, &buffers[3]));
+  RT_CHECK(vx_buffer_address(buffers[0], &q_addr));
+  RT_CHECK(vx_buffer_address(buffers[1], &kt_addr));
+  RT_CHECK(vx_buffer_address(buffers[2], &vt_addr));
+  RT_CHECK(vx_buffer_address(buffers[3], &kernel_arg.O_addr));
+  RT_CHECK(vx_enqueue_write(queue, buffers[0], 0, h_Q.data(), h_Q.size() * 2, 0, nullptr, nullptr));
+  RT_CHECK(vx_enqueue_write(queue, buffers[1], 0, h_KT.data(), h_KT.size() * 2, 0, nullptr, nullptr));
+  RT_CHECK(vx_enqueue_write(queue, buffers[2], 0, h_VT.data(), h_VT.size() * 2, 0, nullptr, nullptr));
+
+  auto program = [&](uint32_t slot, uint64_t addr, uint32_t k, uint32_t rows, uint32_t tile_rows) {
+    RT_CHECK(vortex::dxa::program_2d(device, slot, addr, k, rows, k * 2, stage_k, tile_rows, 2));
+    RT_CHECK(vortex::dxa::set_layout(device, slot, vortex::dxa::Layout::RowMajor, 2, 2));
+  };
+  program(0, q_addr, D, MT, tile_m);
+  program(1, kt_addr, D, LT, L);
+  program(2, vt_addr, LT, N, N);
+
+  RT_CHECK(vx_module_load_file(device, "kernel.vxbin", &module_));
+  RT_CHECK(vx_module_get_kernel(module_, "main", &kernel));
+
+  std::vector<float> h_O(size_t(MT) * N);
+
+  vx_event_h launch_ev = nullptr;
+  vx_launch_info_t li = {};
+  li.struct_size  = sizeof(li);
+  li.kernel       = kernel;
+  li.args_host    = &kernel_arg;
+  li.args_size    = sizeof(kernel_arg);
+  li.ndim         = 2;
+  li.grid_dim[0]  = xc;
+  li.grid_dim[1]  = 1;
+  li.block_dim[0] = warps * uint32_t(NT);
+  li.block_dim[1] = 1;
+  li.lmem_size    = smem_size;
+  li.tmem_cols    = 2 * 128;  // kernel.cpp: kTiles * kTileCols (S, P and O of two Q tiles)
+  RT_CHECK(vx_enqueue_launch(queue, &li, 0, nullptr, &launch_ev));
+  vx_event_h read_o = nullptr;
+  RT_CHECK(vx_enqueue_read(queue, h_O.data(), buffers[3], 0, h_O.size() * 4, 1, &launch_ev, &read_o));
+  RT_CHECK(vx_event_wait_value(read_o, 1, VX_TIMEOUT_INFINITE));
+  vx_event_release(read_o);
+  vx_event_release(launch_ev);
+
+  // Exact softmax over all keys at once; the device computes it online per block.
+  int errors = 0;
+  double max_err = 0;
+  const double scale = kernel_arg.scale;
+  std::vector<double> w(LT);
+  for (uint32_t m = 0; m < MT; ++m) {
+    double s_max = -INFINITY;
+    for (uint32_t l = 0; l < LT; ++l) {
+      double acc = 0;
+      for (uint32_t k = 0; k < D; ++k) {
+        acc += htod(h_Q[size_t(m) * D + k]) * htod(h_KT[size_t(l) * D + k]);
+      }
+      w[l] = acc * scale;
+      s_max = std::max(s_max, w[l]);
+    }
+    double sum = 0;
+    for (auto& x : w) {
+      x = std::exp(x - s_max);
+      sum += x;
+    }
+    for (uint32_t n = 0; n < N; ++n) {
+      double ref = 0;
+      for (uint32_t l = 0; l < LT; ++l) {
+        ref += (w[l] / sum) * htod(h_VT[size_t(n) * LT + l]);
+      }
+      double actual = h_O[size_t(m) * N + n];
+      double err = std::abs(actual - ref) / std::abs(ref);
+      max_err = std::max(max_err, err);
+      if (!(err <= kMaxRelError) && errors++ < 20) {
+        printf("*** O[%u][%u]: expected=%f, actual=%f\n", m, n, ref, actual);
+      }
+    }
+  }
+  std::cout << "O: max relative error " << max_err << ", bound " << kMaxRelError << std::endl;
+
+  cleanup();
+  if (errors) {
+    std::cout << "Found " << errors << " errors!" << std::endl << "FAILED!" << std::endl;
+    return 1;
+  }
+  std::cout << "PASSED!" << std::endl;
+  return 0;
+}
diff -ruN '--exclude=third_party' '--exclude=*.o' '--exclude=.git' src_war/tests/regression/flashattention4/Makefile src_tmem/tests/regression/flashattention4/Makefile
--- src_war/tests/regression/flashattention4/Makefile	1969-12-31 19:00:00.000000000 -0500
+++ src_tmem/tests/regression/flashattention4/Makefile	2026-11-21 00:01:52.996530750 -0500
@@ -0,0 +1,30 @@
+ROOT_DIR := $(realpath ../../..)
+include $(ROOT_DIR)/config.mk
+
+CONFIGS := $(if $(findstring -DVX_CFG_EXT_TCU_ENABLE,$(CONFIGS)),$(CONFIGS),$(CONFIGS) -DVX_CFG_EXT_TCU_ENABLE)
+CONFIGS := $(if $(findstring -DVX_CFG_EXT_DXA_ENABLE,$(CONFIGS)),$(CONFIGS),$(CONFIGS) -DVX_CFG_EXT_DXA_ENABLE)
+
+PROJECT := flashattention4
+
+SRC_DIR := $(VORTEX_HOME)/tests/regression/$(PROJECT)
+
+SRCS := $(SRC_DIR)/main.cpp $(SW_COMMON_DIR)/rvfloats.cpp $(SW_COMMON_DIR)/softfloat_ext.cpp
+
+VX_SRCS := $(SRC_DIR)/kernel.cpp
+
+CONFIGS := $(if $(findstring -DVX_CFG_NUM_WARPS=,$(CONFIGS)),$(CONFIGS),$(CONFIGS) -DVX_CFG_NUM_WARPS=16)
+CONFIGS := $(if $(findstring -DVX_CFG_ISSUE_WIDTH=,$(CONFIGS)),$(CONFIGS),$(CONFIGS) -DVX_CFG_ISSUE_WIDTH=4)
+CONFIGS := $(if $(findstring -DVX_CFG_TCU_WGMMA_ENABLE,$(CONFIGS)),$(CONFIGS),$(CONFIGS) -DVX_CFG_TCU_WGMMA_ENABLE)
+CONFIGS := $(if $(findstring -DVX_CFG_TCU_TMEM_ENABLE,$(CONFIGS)),$(CONFIGS),$(CONFIGS) -DVX_CFG_TCU_TMEM_ENABLE)
+CONFIGS := $(if $(findstring -DVX_CFG_EXT_TFU_ENABLE,$(CONFIGS)),$(CONFIGS),$(CONFIGS) -DVX_CFG_EXT_TFU_ENABLE)
+CONFIGS := $(if $(findstring -DVX_CFG_TCU_TMEM_COLS=,$(CONFIGS)),$(CONFIGS),$(CONFIGS) -DVX_CFG_TCU_TMEM_COLS=512)
+CONFIGS := $(if $(findstring -DDEEP_BUF,$(CONFIGS)),$(CONFIGS),$(CONFIGS) -DDEEP_BUF)
+
+
+CXXFLAGS += -I$(THIRD_PARTY_DIR)/softfloat/source/include
+
+LDFLAGS += $(THIRD_PARTY_DIR)/softfloat/build/Linux-x86_64-GCC/softfloat.a
+
+KERNEL_LIB := vortex2
+
+include ../common.mk
