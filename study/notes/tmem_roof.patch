+++ src_tmem/VX_config.toml	2026-11-21 01:36:33.677665338 -0500
@@ -436,6 +436,22 @@
 VX_CFG_TCU_DSM_ENABLE = false
 VX_CFG_TCU_WGMMA_ENABLE = false
 VX_CFG_TCU_FEDP2K = false
+# A sparse WGMMA uop fills the doubled-K FEDP with compressed A (wgmma.sp k32
+# vs dense k16), so a sparse WGMMA covers twice the dense tile K; without it
+# the FEDP's upper half idles on every sparse uop. It applies where a uop can
+# read two half-K metadata banks per m-step (WMMA k_steps >= 4: NT 8 and 32);
+# elsewhere sparse uops keep the dense tile K.
+VX_CFG_TCU_SPARSE_FULLK_ENABLE = "expr: $VX_CFG_TCU_SPARSE_ENABLE and $VX_CFG_TCU_WGMMA_ENABLE and $VX_CFG_TCU_FEDP2K"
+# Tensor memory: a per-core accumulator of (TCU blocks x WGMMA M) lanes by
+# TMEM_COLS 32-bit columns, written by the TCU's single-thread MMA engine.
+VX_CFG_TCU_TMEM_ENABLE = false
+VX_CFG_TCU_TMEM_COLS = 128
+# N blocks of dense K-major B a tensor op fetches ahead of the one in use; the
+# B buffer holds one more block than that. SimX only above 1.
+VX_CFG_TCU_TMEM_B_AHEAD = 1
+# 1: a tensor op reads row-major A from shared memory a bank row at a time
+# instead of a read per A row. SimX only.
+VX_CFG_TCU_TMEM_A_BANKROW = 0
 
