+#ifndef _SGEMM_TCU_WG_DXA_COMMON_H_
+#define _SGEMM_TCU_WG_DXA_COMMON_H_
+
+#include <stdint.h>
+
+#ifndef WGMMA_NRC
+  #define WGMMA_NRC 8
+#endif
+
+#ifndef ITYPE
+#define ITYPE fp16
+#endif
+
+#ifndef OTYPE
+#define OTYPE fp32
+#endif
+
+// Software-pipeline depth for DEEP_BUF (N-stage generalization of
+// DOUBLE_BUF). Shared between kernel.cpp (loop structure) and main.cpp
+// (SMEM sizing) so they can't drift out of sync.
+#ifndef PIPE_N
+#define PIPE_N 4
+#endif
+
+// Accumulator chunks per CTA tile: an MMA covers TMEM_NCHUNK register-file
+// tiles along N, drained through the registers one chunk at a time.
+#ifndef TMEM_NCHUNK
+  #define TMEM_NCHUNK 1
+#endif
+
+// K-tiles per DEEP_BUF pipeline stage (kernel.cpp: KB). 1 = one K-tile per
+// stage (original behavior).
+#ifndef KB
+  #define KB 1
+#endif
+
+// Shared memory starts with the CTA's TMEM column, padded to keep the stages aligned.
+#ifndef TMEM_SLOT_BYTES
+  #define TMEM_SLOT_BYTES 64
+#endif
+
+typedef struct {
+  uint32_t M, N, K;
+  uint64_t A_addr;
+  uint64_t B_addr;
+  uint64_t C_addr;
+  uint64_t meta_addr;
+} kernel_arg_t;
+
+#endif
diff -ruN '--exclude=third_party' '--exclude=*.o' '--exclude=.git' src_war/tests/regression/sgemm_tcu_tmem/kernel.cpp src_tmem/tests/regression/sgemm_tcu_tmem/kernel.cpp
--- src_war/tests/regression/sgemm_tcu_tmem/kernel.cpp	1969-12-31 19:00:00.000000000 -0500
+++ src_tmem/tests/regression/sgemm_tcu_tmem/kernel.cpp	2026-11-21 00:01:53.053321568 -0500
@@ -0,0 +1,290 @@
+#include "common.h"
+#include <vx_spawn2.h>
+#include <vx_tensor.h>
+#include <vx_tmem.h>
+#include <vx_intrinsics.h>
+#include <vx_dxa.h>
+#include <vx_barrier.h>
+
+namespace vt = vortex::tensor;
+namespace tm = vortex::tmem;
+using ctx = vt::wgmma_context<VX_CFG_NUM_THREADS, vt::ITYPE, vt::OTYPE, false, WGMMA_NRC>;
+using wg_cfg = vt::wgmma_config_t<VX_CFG_NUM_THREADS, vt::ITYPE, vt::OTYPE, WGMMA_NRC>;
+
+#ifdef TMEM_SPARSE
+constexpr bool     kSparse = true;
+constexpr uint32_t kTileK  = wg_cfg::tileK_sp;
+#else
+constexpr bool     kSparse = false;
+constexpr uint32_t kTileK  = ctx::tileK;
+#endif
+#ifdef TMEM_A
+constexpr bool kATmem = true;
+#else
+constexpr bool kATmem = false;
+#endif
+// The TCU copies the staged metadata into TMEM (tc.cp) instead of the warps.
+#ifdef TMEM_CP
+constexpr bool kCopyMeta = kSparse;
+#else
+constexpr bool kCopyMeta = false;
+#endif
+
+// DXA descriptor slots (programmed by host in main.cpp).
+constexpr uint32_t kDescA = 0;
+constexpr uint32_t kDescB = 1;
+[[maybe_unused]] constexpr uint32_t kDescMeta = 2;
+
+#if (KB > 1) && !defined(B_KMAJOR)
+#error "KB > 1 requires B_KMAJOR"
+#endif
+
+static inline __attribute__((always_inline)) uint32_t b_coord0(uint32_t k, uint32_t col) {
+#ifdef B_KMAJOR
+  (void)col; return k;
+#else
+  (void)k; return col;
+#endif
+}
+static inline __attribute__((always_inline)) uint32_t b_coord1(uint32_t k, uint32_t col) {
+#ifdef B_KMAJOR
+  (void)k; return col;
+#else
+  (void)col; return k;
+#endif
+}
+
+static_assert(sizeof(ctx::output_t) == sizeof(float), "the TMEM epilogue stores fp32 lanes");
+
+constexpr uint32_t kPipeN = PIPE_N;
+constexpr uint32_t kTileN = ctx::xtileN * TMEM_NCHUNK;  // CTA tile N
+constexpr uint32_t kBK    = KB * kTileK;  // K per pipeline stage
+// tc.mma K-tiles (one FEDP width of A each) per kTileK: a dense tile spans
+// k_steps of them, a sparse one exactly one.
+constexpr uint32_t kKtPerTile = kSparse ? 1 : wg_cfg::k_steps;
+constexpr uint32_t kAK    = kSparse ? (kBK / 2) : kBK;  // A is compressed along K
+#ifdef B_KMAJOR
+constexpr uint32_t kBLdmBytes = kBK * sizeof(ctx::input_t);
+#else
+constexpr uint32_t kBLdmBytes = 0;
+#endif
+
+// Full, empty, done and TMEM-load barriers of a CTA.
+static_assert(2 * kPipeN + 2 <= VX_CFG_NUM_BARRIERS, "not enough barriers for PIPE_N");
+
+constexpr uint32_t kThreadsPerLane = VX_CFG_NUM_THREADS / ctx::xtileM;
+// A K step's metadata takes one fragment group of TMEM columns per lane.
+constexpr uint32_t kFragCols = tm::frag_cols();
+constexpr uint32_t kMetaCols = (wg_cfg::fedpK * 2 * (32 / vt::ITYPE::bits) + 31) / 32;
+static_assert(kMetaCols <= kFragCols, "a K step's metadata fits a fragment group");
+// One tc.mma K step: fedpK words of A (compressed when sparse) and of B per
+// K-major row (twice that when sparse).
+constexpr uint32_t kKtBytes = wg_cfg::fedpK * 4;
+// tmem::store writes whole fragments.
+constexpr uint32_t kStoreCols = ctx::fragment_acc::NR * kThreadsPerLane;
+
+// Warp `lane` group: copy `cols` columns from global words [row][col] into TMEM.
+[[maybe_unused]] static inline void load_tmem_cols(uint32_t lane, uint32_t col0, uint32_t cols,
+                                  const float* src, uint32_t stride, uint32_t row0) {
+  const uint32_t t = vx_thread_id();
+  const uint32_t row = row0 + t % ctx::xtileM;
+  for (uint32_t c = 0; c < cols; c += kStoreCols) {
+    ctx::fragment_acc frag;
+    #pragma unroll
+    for (uint32_t r = 0; r < ctx::fragment_acc::NR; ++r) {
+      uint32_t col = c + r * kThreadsPerLane + t / ctx::xtileM;
+      frag.data[r] = (col < stride) ? src[row * stride + col] : 0.0f;
+    }
+    tm::store<tm::LANE_PER_THREAD>(tm::make_taddr(lane, col0 + c), frag);
+  }
+  tm::wait_st();
+}
+
+// Warp `lane` group: copy `cols` columns of the CTA's [row][stride] words in
+// shared memory into TMEM, a fragment per register. Columns past `stride`
+// pick up the next row's words, which the MMA never reads.
+[[maybe_unused]] static inline void smem_to_tmem_cols(uint32_t lane, uint32_t col0, uint32_t cols,
+                                                      const float* src, uint32_t stride) {
+  const uint32_t t = vx_thread_id();
+  for (uint32_t c = 0; c < cols; c += kStoreCols) {
+    ctx::fragment_acc frag;
+    #pragma unroll
+    for (uint32_t r = 0; r < ctx::fragment_acc::NR; ++r) {
+      frag.data[r] = src[(lane + (r % wg_cfg::m_steps) * wg_cfg::tcM + t / wg_cfg::tcN) * stride
+                         + c + (r / wg_cfg::m_steps) * wg_cfg::tcN + t % wg_cfg::tcN];
+    }
+    tm::store<tm::FRAGMENT>(tm::make_taddr(lane, col0 + c), frag);
+  }
+  tm::wait_st();
+}
+
+__kernel void kernel_main(kernel_arg_t* __UNIFORM__ arg) {
+  auto pC = reinterpret_cast<ctx::output_t *>(arg->C_addr);
+
+  uint32_t N = arg->N;
+  uint32_t K = arg->K;
+
+  uint32_t tid = threadIdx.x;
+  uint32_t num_threads = blockDim.x;
+  uint32_t warp_rank = tid / VX_CFG_NUM_THREADS;
+  uint32_t num_warps = num_threads / VX_CFG_NUM_THREADS;
+
+  // One warp per TCU block: block b computes rows [b*xtileM, (b+1)*xtileM).
+  uint32_t cta_M = num_warps * ctx::xtileM;
+  uint32_t tile_row = blockIdx.y * cta_M;
+  uint32_t tile_col = blockIdx.x * kTileN;
+
+  auto lmem = reinterpret_cast<uint8_t*>(__local_mem());
+  auto tmem_slot = reinterpret_cast<volatile uint32_t*>(lmem);
+  auto smem = reinterpret_cast<ctx::input_t *>(lmem + TMEM_SLOT_BYTES);
+  const uint32_t stage_a_elems = kATmem ? 0 : (cta_M * kAK);
+  const uint32_t stage_elems = stage_a_elems + kBK * kTileN;
+  auto stage_A = [&](uint32_t s) { return smem + s * stage_elems; };
+  auto stage_B = [&](uint32_t s) { return smem + s * stage_elems + stage_a_elems; };
+
+  const uint32_t cta_id = get_local_group_id();
+  auto full_bar  = [&](uint32_t s) { return cta_id | (s << 8); };
+  auto empty_bar = [&](uint32_t s) { return cta_id | ((kPipeN + s) << 8); };
+  const uint32_t done_bar = cta_id | ((2 * kPipeN) << 8);
+  const uint32_t load_bar = cta_id | ((2 * kPipeN + 1) << 8);
+
+  const uint32_t num_steps = K / kBK;
+  const uint32_t k_tiles   = K / kTileK;
+
+  // TMEM: D, then A (a_tmem), then the metadata (sparse).
+  auto round_store = [](uint32_t cols) { return ((cols + kStoreCols - 1) / kStoreCols) * kStoreCols; };
+  const uint32_t a_cols     = k_tiles * kKtPerTile * wg_cfg::fedpK;
+  const uint32_t meta_words = k_tiles * kFragCols;
+  const uint32_t tmem_cols  = tm::alloc_cols(kTileN + (kATmem ? round_store(a_cols) : 0)
+                                                    + (kSparse ? round_store(meta_words) : 0));
+  if (warp_rank == 0) {
+    uint32_t col = tm::alloc(tmem_cols);
+    if (vx_thread_id() == 0) {
+      *tmem_slot = col;
+    }
+  }
+  vx_barrier(load_bar, num_warps);
+  const uint32_t taddr    = *tmem_slot;
+  const uint32_t a_col    = taddr + kTileN;
+  const uint32_t meta_col = a_col + (kATmem ? round_store(a_cols) : 0);
+  const uint32_t lane0   = tm::warp_lane();
+  const uint32_t row0    = tile_row + lane0;
+  // The metadata is staged through the pipeline stages, which no MMA uses yet:
+  // for tc.cp pre-packed in TMEM storage order (one row of the CTA's blob),
+  // else row by row, padded to NT words.
+  const uint32_t meta_pitch = (meta_words + VX_CFG_NUM_THREADS - 1) / VX_CFG_NUM_THREADS * VX_CFG_NUM_THREADS;
+  if constexpr (kSparse) {
+    if (warp_rank == 0) {
+      vx_barrier_expect_tx(load_bar, 1);
+      vx_dxa_issue_2d_wg(kDescMeta, load_bar, smem, 0, kCopyMeta ? blockIdx.y : tile_row);
+    }
+  }
+  if constexpr (kATmem) {
+    const uint32_t a_stride = ((K * sizeof(ctx::input_t)) / (kSparse ? 2 : 1)) / 4;
+    load_tmem_cols(lane0, a_col, a_cols, reinterpret_cast<const float*>(arg->A_addr), a_stride, row0);
+  }
+  if constexpr (kCopyMeta) {
+    // With A in TMEM every warp meets on load_bar again, so all wait here too.
+    if (kATmem || warp_rank == 0) {
+      vx_barrier(load_bar, kATmem ? num_warps : 1);
+    }
+  } else if constexpr (kSparse) {
+    vx_barrier(load_bar, num_warps);
+    smem_to_tmem_cols(lane0, meta_col, meta_words, reinterpret_cast<const float*>(smem), meta_pitch);
+  }
+  if constexpr (kATmem || (kSparse && !kCopyMeta)) {
+    vx_barrier(load_bar, num_warps);
+  }
+
+  if (warp_rank == 0) {
+    if constexpr (kCopyMeta) {
+      // The copy runs ahead of every tc.mma; the stages that hold the staged
+      // metadata are refilled only once it completes.
+      tm::cp(meta_col, smem, meta_words);
+      tm::commit(load_bar, 2);
+      vx_barrier(load_bar, 2);
+    }
+    // Producer: this warp and the MMA warp are the two participants of every
+    // full and empty barrier.
+    for (uint32_t i = 0; i < num_steps; ++i) {
+      uint32_t s = i % kPipeN;
+      if (i >= kPipeN) {
+        int phase = vx_barrier_arrive(empty_bar(s), 2);
+        vx_barrier_wait(empty_bar(s), phase);
+      }
+      uint32_t k = i * kBK;
+      vx_barrier_expect_tx(full_bar(s), kATmem ? 1 : 2);
+      if constexpr (!kATmem) {
+        vx_dxa_issue_2d_wg(kDescA, full_bar(s), stage_A(s), i * kAK, tile_row);
+      }
+      vx_dxa_issue_2d_wg(kDescB, full_bar(s), stage_B(s), b_coord0(k, tile_col), b_coord1(k, tile_col));
+      vx_barrier_arrive(full_bar(s), 2);
+    }
+    // Close the last generation of every empty barrier the MMA warp committed.
+    uint32_t first = (num_steps > kPipeN) ? (num_steps - kPipeN) : 0;
+    for (uint32_t i = first; i < num_steps; ++i) {
+      uint32_t s = i % kPipeN;
+      int phase = vx_barrier_arrive(empty_bar(s), 2);
+      vx_barrier_wait(empty_bar(s), phase);
+    }
+  } else if (warp_rank == 1) {
+    // Per stage: wait for it, multiply, and commit it back to the producer;
+    // the last commit completes the GEMM.
+    // One tc.mma per K step, its descriptor in the instruction.
+    constexpr uint32_t kSteps = KB * kKtPerTile;
+    constexpr uint32_t kALd = kAK * sizeof(ctx::input_t);
+    // B's K step: along a K-major row, or a block-major K-tile's n_frag blocks.
+    constexpr uint32_t kBStepBytes = (kBLdmBytes != 0) ? (kKtBytes * (kSparse ? 2 : 1))
+                                                       : (kTileN * kKtBytes);
+    for (uint32_t i = 0; i < num_steps; ++i) {
+      uint32_t s = i % kPipeN;
+      int phase = vx_barrier_arrive(full_bar(s), 2);
+      vx_barrier_wait(full_bar(s), phase);
+      const uint32_t a_off = tm::smem_offset(stage_A(s));
+      const uint32_t b_off = tm::smem_offset(stage_B(s));
+      for (uint32_t kt = 0; kt < kSteps; ++kt) {
+        const uint32_t gk = i * kSteps + kt;
+        const auto idesc = tm::make_idesc<vt::ITYPE>(kTileN / ctx::tcN, taddr, gk == 0,
+                                                     kSparse, kSparse ? (meta_col + gk * kFragCols) : 0);
+        const auto b = tm::smem_desc(b_off + kt * kBStepBytes, kBLdmBytes);
+        if constexpr (kATmem) {
+          tm::mma(idesc, tm::tmem_col{a_col + gk * wg_cfg::fedpK}, b);
+        } else {
+          tm::mma(idesc, tm::smem_desc(a_off + kt * kKtBytes, kALd), b);
+        }
+      }
+      tm::commit(empty_bar(s), 2);
+    }
+    tm::commit(done_bar, num_warps + 1);
+  }
+
+  // Epilogue: wait for the MMAs; warp r drains TMEM lanes (M rows)
+  // [r*xtileM, (r+1)*xtileM), xtileN columns per load.
+  vx_barrier(done_bar, num_warps + 1);
+
+  const uint32_t lane = tm::warp_lane();
+  for (uint32_t c = 0; c < TMEM_NCHUNK; ++c) {
+    ctx::fragment_acc fragC;
+    uint32_t col = taddr + c * ctx::xtileN;
+    auto pChunkC = pC + (tile_row + lane) * N + tile_col + c * ctx::xtileN;
+  #ifdef TMEM_LANE_PER_THREAD
+    // Thread t holds one M row; a store writes NT rows.
+    constexpr uint32_t kThreadsPerLane = VX_CFG_NUM_THREADS / ctx::xtileM;
+    const uint32_t t = vx_thread_id();
+    tm::load<tm::LANE_PER_THREAD>(fragC, tm::make_taddr(lane, col));
+    auto pRowC = reinterpret_cast<float*>(pChunkC + (t % ctx::xtileM) * N + t / ctx::xtileM);
+    for (uint32_t r = 0; r < ctx::fragment_acc::NR; ++r) {
+      pRowC[r * kThreadsPerLane] = fragC.data[r];
+    }
+  #else
+    // The WGMMA accumulator layout: the WGMMA context stores it.
+    tm::load<tm::FRAGMENT>(fragC, tm::make_taddr(lane, col));
+    ctx::store_matrix_sync(pChunkC, fragC, N);
+  #endif
+  }
+
+  vx_barrier(load_bar, num_warps);
+  if (warp_rank == 0) {
+    tm::dealloc(taddr, tmem_cols);
+  }
+}
diff -ruN '--exclude=third_party' '--exclude=*.o' '--exclude=.git' src_war/tests/regression/sgemm_tcu_tmem/main.cpp src_tmem/tests/regression/sgemm_tcu_tmem/main.cpp
--- src_war/tests/regression/sgemm_tcu_tmem/main.cpp	1969-12-31 19:00:00.000000000 -0500
+++ src_tmem/tests/regression/sgemm_tcu_tmem/main.cpp	2026-11-21 00:01:53.060995636 -0500
@@ -0,0 +1,782 @@
+#include "common.h"
+#include <algorithm>
+#include <chrono>
+#include <type_traits>
+#include <cmath>
+#include <iostream>
+#include <rvfloats.h>
+#include <string.h>
+#include <tensor_cfg.h>
+#include <tensor_sp.h>
+#include <unistd.h>
+#include <util.h>
+#include <vector>
+#include <vortex2.h>
+#include <dxa.h>
+
+// The TCU chains K/tileK dot-product ops, each rounding its accumulator to fp32
+// once, while the CPU reference accumulates in double (no intermediate rounding).
+// A wider tile rounds fewer times but sums more elements per rounding, so the two
+// effects cancel and the drift tracks K rather than the chain depth: it measures
+// ~K/8 ULP across every gated NUM_THREADS (16 ULP at K=128 for both tileK=8 and
+// tileK=16). float_ulp() therefore scales with K and carries 2x headroom, since a
+// fixed bound silently depends on the tile shape. The RTL datapath itself is
+// verified bit-exactly against its windowed reference by hw/unittest/tcu_fedp
+// (`make -C hw/unittest run-tcu`), so this bounds a reference idealization, not a
+// hardware tolerance.
+static uint32_t g_float_ulp = 16;
+static uint32_t g_max_ulp = 0;
+
+static uint32_t float_ulp(uint32_t K) {
+  return std::max<uint32_t>(8, K / 5);
+}
+#define MAX_ERRORS 100
+
+#define RT_CHECK(_expr)                                      \
+  do {                                                       \
+    int _ret = _expr;                                        \
+    if (0 == _ret)                                           \
+      break;                                                 \
+    printf("Error: '%s' returned %d!\n", #_expr, (int)_ret); \
+    cleanup();                                               \
+    exit(-1);                                                \
+  } while (false)
+
+using namespace vortex;
+namespace vt = tensor;
+
+///////////////////////////////////////////////////////////////////////////////
+
+template <typename Type>
+class Comparator {};
+
+template <>
+class Comparator<vt::fp32> {
+public:
+  static float generate() {
+    return static_cast<float>(rand()) / RAND_MAX;
+  }
+  static bool compare(float a, float b, int index, int errors) {
+    union fi_t {
+      float f;
+      int32_t i;
+    };
+    fi_t fa, fb;
+    fa.f = a;
+    fb.f = b;
+    auto d = std::abs(fa.i - fb.i);
+    g_max_ulp = std::max(g_max_ulp, static_cast<uint32_t>(d));
+    if (d > static_cast<int32_t>(g_float_ulp)) {
+      if (errors < MAX_ERRORS) {
+        printf("*** error: [%d] expected=%f, actual=%f\n", index, fb.f, fa.f);
+      }
+      return false;
+    }
+    return true;
+  }
+};
+
+template <>
+class Comparator<vt::fp16> {
+public:
+  static uint16_t generate() {
+    auto fvalue = float(rand()) / RAND_MAX;
+    return rv_ftoh_s(bit_cast<uint32_t>(fvalue), 0, nullptr);
+  }
+  static bool compare(uint16_t a, uint16_t b, int index, int errors) {
+    if (a != b) {
+      if (errors < MAX_ERRORS) {
+        printf("*** error: [%d] expected=0x%x, actual=0x%x\n", index, b, a);
+      }
+      return false;
+    }
+    return true;
+  }
+};
+
+template <>
+class Comparator<vt::bf16> {
+public:
+  static uint16_t generate() {
+    auto fvalue = float(rand()) / RAND_MAX;
+    return rv_ftob_s(bit_cast<uint32_t>(fvalue), 0, nullptr);
+  }
+};
+
+template <>
+class Comparator<vt::fp8> {
+public:
+  static uint8_t generate() {
+    auto fvalue = float(rand()) / RAND_MAX;
+    return rv_ftoe4m3_s(bit_cast<uint32_t>(fvalue), 0, nullptr);
+  }
+  static bool compare(uint8_t a, uint8_t b, int index, int errors) {
+    if (a != b) {
+      if (errors < MAX_ERRORS) {
+        printf("*** error: [%d] expected=0x%x, actual=0x%x\n", index, b, a);
+      }
+      return false;
+    }
+    return true;
+  }
+};
+
+template <>
+class Comparator<vt::bf8> {
+public:
+  static uint8_t generate() {
+    auto fvalue = float(rand()) / RAND_MAX;
+    return rv_ftoe5m2_s(bit_cast<uint32_t>(fvalue), 0, nullptr);
+  }
+  static bool compare(uint8_t a, uint8_t b, int index, int errors) {
+    if (a != b) {
+      if (errors < MAX_ERRORS) {
+        printf("*** error: [%d] expected=0x%x, actual=0x%x\n", index, b, a);
+      }
+      return false;
+    }
+    return true;
+  }
+};
+
+template <>
+class Comparator<vt::int8> {
+public:
+  static int8_t generate() {
+    return static_cast<int8_t>(rand());
+  }
+  static bool compare(int8_t a, int8_t b, int index, int errors) {
+    if (a != b) {
+      if (errors < MAX_ERRORS) {
+        printf("*** error: [%d] expected=%d, actual=%d\n", index, b, a);
+      }
+      return false;
+    }
+    return true;
+  }
+};
