diff -ruN '--exclude=third_party' a/tests/regression/warp_rate/common.h b/tests/regression/warp_rate/common.h
--- a/tests/regression/warp_rate/common.h	1969-12-31 19:00:00.000000000 -0500
+++ b/tests/regression/warp_rate/common.h	2026-11-21 14:44:58.724033342 -0500
@@ -0,0 +1,29 @@
+#ifndef _COMMON_H_
+#define _COMMON_H_
+
+#include <stdint.h>
+
+// Instruction classes; each loop iteration is one inline-asm block whose
+// instruction count is checked in the kernel disassembly.
+#define WR_INT_DEP     0  // 128 dependent adds
+#define WR_INT_IND4    1  // 128 adds on 4 independent chains
+#define WR_INT_IND8    2  // 128 adds on 8 independent chains
+#define WR_FMA_DEP     3  // 128 dependent fmadd.s
+#define WR_FMA_IND4    4  // 128 fmadd.s on 4 chains
+#define WR_FMA_IND8    5  // 128 fmadd.s on 8 chains
+#define WR_BR1         6  // 128 taken branches
+#define WR_BR4         7  // 32 x (3 adds + taken branch)
+#define WR_BR16        8  // 8 x (15 adds + taken branch)
+#define WR_LDS_OWN     9  // 16 x (8 loads of the thread's own shared word + 8 xors)
+#define WR_LDS_CHASE  10  // 128 dependent shared loads (self pointer)
+#define WR_STS_OWN    11  // 128 stores of the thread's own shared word
+#define WR_LDS_NOUSE  12  // 128 shared loads into 8 rotating registers, never read
+#define WR_NKINDS     13
+
+typedef struct {
+  uint32_t kind;
+  uint32_t iters;
+  uint64_t out_addr;  // per warp: start cycle, end cycle
+} kernel_arg_t;
+
+#endif
diff -ruN '--exclude=third_party' a/tests/regression/warp_rate/kernel.cpp b/tests/regression/warp_rate/kernel.cpp
--- a/tests/regression/warp_rate/kernel.cpp	1969-12-31 19:00:00.000000000 -0500
+++ b/tests/regression/warp_rate/kernel.cpp	2026-11-21 15:19:24.302297233 -0500
@@ -0,0 +1,122 @@
+#include <vx_spawn2.h>
+#include <vx_intrinsics.h>
+#include "common.h"
+
+#define R2(x) x x
+#define R4(x) R2(x) R2(x)
+#define R8(x) R4(x) R4(x)
+#define R16(x) R8(x) R8(x)
+#define R32(x) R16(x) R16(x)
+#define R64(x) R32(x) R32(x)
+#define R128(x) R64(x) R64(x)
+
+#define IADD4 "add %0, %0, %8\n\tadd %1, %1, %8\n\tadd %2, %2, %8\n\tadd %3, %3, %8\n\t"
+#define IADD8 IADD4 "add %4, %4, %8\n\tadd %5, %5, %8\n\tadd %6, %6, %8\n\tadd %7, %7, %8\n\t"
+#define FMA4 "fmadd.s %0, %0, %8, %9\n\tfmadd.s %1, %1, %8, %9\n\tfmadd.s %2, %2, %8, %9\n\tfmadd.s %3, %3, %8, %9\n\t"
+#define FMA8 FMA4 "fmadd.s %4, %4, %8, %9\n\tfmadd.s %5, %5, %8, %9\n\tfmadd.s %6, %6, %8, %9\n\tfmadd.s %7, %7, %8, %9\n\t"
+// taken branch over one never-executed add (%9 != 0 at run time)
+#define BRSKIP "bnez %9, 1f\n\taddi %4, %4, 1\n1:\n\t"
+#define A1 "add %1, %1, %8\n\t"
+#define A2 "add %2, %2, %8\n\t"
+#define A3 "add %3, %3, %8\n\t"
+#define A0 "add %0, %0, %8\n\t"
+#define BLK4 A1 A2 A3 BRSKIP
+#define BLK16 A0 A1 A2 A3 A0 A1 A2 A3 A0 A1 A2 A3 A0 A1 A2 BRSKIP
+#define LDS8 "lw %0, 0(%12)\n\tlw %1, 0(%12)\n\tlw %2, 0(%12)\n\tlw %3, 0(%12)\n\t" \
+             "lw %4, 0(%12)\n\tlw %5, 0(%12)\n\tlw %6, 0(%12)\n\tlw %7, 0(%12)\n\t" \
+             "xor %8, %8, %0\n\txor %8, %8, %1\n\txor %9, %9, %2\n\txor %9, %9, %3\n\t" \
+             "xor %10, %10, %4\n\txor %10, %10, %5\n\txor %11, %11, %6\n\txor %11, %11, %7\n\t"
+#define LDN8 "lw %0, 0(%8)\n\tlw %1, 0(%8)\n\tlw %2, 0(%8)\n\tlw %3, 0(%8)\n\t" \
+             "lw %4, 0(%8)\n\tlw %5, 0(%8)\n\tlw %6, 0(%8)\n\tlw %7, 0(%8)\n\t"
+
+__kernel void kernel_main(kernel_arg_t* __UNIFORM__ arg) {
+  const uint32_t kind = arg->kind, iters = arg->iters;
+  const uint32_t t = threadIdx.x;
+  auto out = reinterpret_cast<uint64_t*>(arg->out_addr);
+  auto lmem = reinterpret_cast<uintptr_t*>(__local_mem());
+  uintptr_t myword = (uintptr_t)(lmem + t);
+  lmem[t] = myword;   // self pointer for the chase
+  size_t y = 3 + (kind & 1), nz = 1 + (t & 1);
+  size_t a0 = t, a1 = t + 1, a2 = t + 2, a3 = t + 3, a4 = t + 4, a5 = t + 5, a6 = t + 6, a7 = t + 7;
+  size_t b0 = 0, b1 = 0, b2 = 0, b3 = 0;
+  float f0 = 1.f + t, f1 = f0 + 1, f2 = f0 + 2, f3 = f0 + 3, f4 = f0 + 4, f5 = f0 + 5, f6 = f0 + 6, f7 = f0 + 7;
+  float fa = 0.999f, fb = 1e-3f;
+  if (kind == WR_LDS_CHASE) a0 = myword;
+  // opaque to the compiler, so it keeps them in registers instead of reloading them in the loop
+  __asm__ volatile("" : "+f"(fa), "+f"(fb), "+r"(y), "+r"(nz));
+  __syncthreads();
+
+  uint64_t c0 = csr_read(VX_CSR_MCYCLE);
+  switch (kind) {
+  case WR_INT_DEP:
+    for (uint32_t i = 0; i < iters; ++i)
+      __asm__ volatile(R128("add %0, %0, %1\n\t") : "+r"(a0) : "r"(y));
+    break;
+  case WR_INT_IND4:
+    for (uint32_t i = 0; i < iters; ++i)
+      __asm__ volatile(R32(IADD4) : "+r"(a0), "+r"(a1), "+r"(a2), "+r"(a3), "+r"(a4), "+r"(a5), "+r"(a6), "+r"(a7) : "r"(y));
+    break;
+  case WR_INT_IND8:
+    for (uint32_t i = 0; i < iters; ++i)
+      __asm__ volatile(R16(IADD8) : "+r"(a0), "+r"(a1), "+r"(a2), "+r"(a3), "+r"(a4), "+r"(a5), "+r"(a6), "+r"(a7) : "r"(y));
+    break;
+  case WR_FMA_DEP:
+    for (uint32_t i = 0; i < iters; ++i)
+      __asm__ volatile(R128("fmadd.s %0, %0, %1, %2\n\t") : "+f"(f0) : "f"(fa), "f"(fb));
+    break;
+  case WR_FMA_IND4:
+    for (uint32_t i = 0; i < iters; ++i)
+      __asm__ volatile(R32(FMA4) : "+f"(f0), "+f"(f1), "+f"(f2), "+f"(f3), "+f"(f4), "+f"(f5), "+f"(f6), "+f"(f7) : "f"(fa), "f"(fb));
+    break;
+  case WR_FMA_IND8:
+    for (uint32_t i = 0; i < iters; ++i)
+      __asm__ volatile(R16(FMA8) : "+f"(f0), "+f"(f1), "+f"(f2), "+f"(f3), "+f"(f4), "+f"(f5), "+f"(f6), "+f"(f7) : "f"(fa), "f"(fb));
+    break;
+  case WR_BR1:
+    for (uint32_t i = 0; i < iters; ++i)
+      __asm__ volatile(R128(BRSKIP) : "+r"(a0), "+r"(a1), "+r"(a2), "+r"(a3), "+r"(a4), "+r"(a5), "+r"(a6), "+r"(a7) : "r"(y), "r"(nz));
+    break;
+  case WR_BR4:
+    for (uint32_t i = 0; i < iters; ++i)
+      __asm__ volatile(R32(BLK4) : "+r"(a0), "+r"(a1), "+r"(a2), "+r"(a3), "+r"(a4), "+r"(a5), "+r"(a6), "+r"(a7) : "r"(y), "r"(nz));
+    break;
+  case WR_BR16:
+    for (uint32_t i = 0; i < iters; ++i)
+      __asm__ volatile(R8(BLK16) : "+r"(a0), "+r"(a1), "+r"(a2), "+r"(a3), "+r"(a4), "+r"(a5), "+r"(a6), "+r"(a7) : "r"(y), "r"(nz));
+    break;
+  case WR_LDS_OWN:
+    for (uint32_t i = 0; i < iters; ++i)
+      __asm__ volatile(R16(LDS8) : "=&r"(a0), "=&r"(a1), "=&r"(a2), "=&r"(a3), "=&r"(a4), "=&r"(a5), "=&r"(a6), "=&r"(a7),
+                       "+r"(b0), "+r"(b1), "+r"(b2), "+r"(b3) : "r"(myword) : "memory");
+    break;
+  case WR_LDS_CHASE:
+    for (uint32_t i = 0; i < iters; ++i)
+      __asm__ volatile(R128("ld %0, 0(%0)\n\t") : "+r"(a0) :: "memory");
+    break;
+  case WR_STS_OWN:
+    for (uint32_t i = 0; i < iters; ++i)
+      __asm__ volatile(R128("sw %1, 0(%0)\n\t") :: "r"(myword), "r"(a1) : "memory");
+    break;
+  case WR_LDS_NOUSE:
+    for (uint32_t i = 0; i < iters; ++i)
+      __asm__ volatile(R16(LDN8) : "=&r"(a0), "=&r"(a1), "=&r"(a2), "=&r"(a3), "=&r"(a4), "=&r"(a5), "=&r"(a6), "=&r"(a7) : "r"(myword) : "memory");
+    break;
+  default:
+    break;
+  }
+  uint64_t c1 = csr_read(VX_CSR_MCYCLE);
+
+  // every thread's final registers, which the host hashes: a run that executed
+  // a different instruction stream gives a different hash
+  float fv = f0 + f1 + f2 + f3 + f4 + f5 + f6 + f7;
+  uint32_t fbits;
+  __builtin_memcpy(&fbits, &fv, sizeof(fbits));
+  uint32_t nw = blockDim.x / vx_num_threads();
+  out[2 * nw + t] = (a0 ^ (a1 << 1) ^ (a2 << 2) ^ (a3 << 3) ^ (a4 << 4) ^ (a5 << 5) ^ (a6 << 6) ^ (a7 << 7)
+                     ^ (b0 << 8) ^ (b1 << 9) ^ (b2 << 10) ^ (b3 << 11)) + fbits;
+  if ((t % vx_num_threads()) == 0) {
+    uint32_t w = t / vx_num_threads();
+    out[2 * w] = c0;
+    out[2 * w + 1] = c1;
+  }
+}
diff -ruN '--exclude=third_party' a/tests/regression/warp_rate/main.cpp b/tests/regression/warp_rate/main.cpp
--- a/tests/regression/warp_rate/main.cpp	1969-12-31 19:00:00.000000000 -0500
+++ b/tests/regression/warp_rate/main.cpp	2026-11-21 15:19:24.308052559 -0500
@@ -0,0 +1,142 @@
+// Issue rate of one warp, and of W warps sharing one core, by instruction
+// class. One CTA of W warps runs `iters` iterations of one inline-asm block
+// (common.h lists the classes); each warp reads mcycle around its loop.
+// Prints the slowest warp's own loop time and the core span (first warp's
+// start to last warp's end) per iteration.
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <iostream>
+#include <unistd.h>
+#include <vector>
+#include <vortex2.h>
+#include "common.h"
+
+#define RT_CHECK(_expr)                                         \
+   do {                                                         \
+     int _ret = _expr;                                          \
+     if (0 == _ret)                                             \
+       break;                                                   \
+     printf("Error: '%s' returned %d!\n", #_expr, (int)_ret);   \
+     cleanup();                                                 \
+     exit(-1);                                                  \
+   } while (false)
+
+static const char* kNames[WR_NKINDS] = {
+  "int_dep", "int_ind4", "int_ind8", "fma_dep", "fma_ind4", "fma_ind8",
+  "br_every1", "br_every4", "br_every16", "lds_own", "lds_chase", "sts_own", "lds_nouse"};
+
+const char* kernel_file = "kernel.vxbin";
+uint32_t kind  = 0;
+uint32_t warps = 1;
+uint32_t iters = 64;
+
+vx_device_h device = nullptr;
+vx_buffer_h out_buffer = nullptr;
+vx_queue_h  queue   = nullptr;
+vx_module_h module_ = nullptr;
+vx_kernel_h kernel  = nullptr;
+kernel_arg_t kernel_arg = {};
+
+static void show_usage() {
+  std::cout << "Usage: [-k kind 0.." << WR_NKINDS - 1 << "] [-w warps] [-i iterations] [-h]" << std::endl;
+}
+
+static void parse_args(int argc, char **argv) {
+  int c;
+  while ((c = getopt(argc, argv, "k:w:i:h")) != -1) {
+    switch (c) {
+    case 'k': kind  = atoi(optarg); break;
+    case 'w': warps = atoi(optarg); break;
+    case 'i': iters = atoi(optarg); break;
+    case 'h': show_usage(); exit(0);
+    default:  show_usage(); exit(-1);
+    }
+  }
+  if (kind >= WR_NKINDS || warps == 0 || iters == 0) {
+    show_usage();
+    exit(-1);
+  }
+}
+
+void cleanup() {
+  if (device) {
+    if (out_buffer) vx_buffer_release(out_buffer);
+    if (kernel)  vx_kernel_release(kernel);
+    if (module_) vx_module_release(module_);
+    if (queue)   vx_queue_release(queue);
+    vx_device_dump_perf(device, stdout);
+    vx_device_release(device);
+  }
+}
+
+int main(int argc, char *argv[]) {
+  parse_args(argc, argv);
+  RT_CHECK(vx_device_open(0, &device));
+  vx_queue_info_t qi = { sizeof(qi), nullptr, VX_QUEUE_PRIORITY_NORMAL, 0 };
+  RT_CHECK(vx_queue_create(device, &qi, &queue));
+
+  uint64_t num_threads, num_warps;
+  RT_CHECK(vx_device_query(device, VX_CAPS_NUM_THREADS, &num_threads));
+  RT_CHECK(vx_device_query(device, VX_CAPS_NUM_WARPS, &num_warps));
+  if (warps > num_warps) {
+    std::cout << "Error: " << warps << " warps > " << num_warps << " per core" << std::endl;
+    return -1;
+  }
+
+  uint64_t nthreads = warps * num_threads;
+  uint64_t out_size = (warps * 2 + nthreads) * sizeof(uint64_t);
+  RT_CHECK(vx_buffer_create(device, out_size, VX_MEM_WRITE, &out_buffer));
+  RT_CHECK(vx_buffer_address(out_buffer, &kernel_arg.out_addr));
+  kernel_arg.kind  = kind;
+  kernel_arg.iters = iters;
+
+  RT_CHECK(vx_module_load_file(device, kernel_file, &module_));
+  RT_CHECK(vx_module_get_kernel(module_, "main", &kernel));
+
+  vx_event_h launch_ev = nullptr, read_ev = nullptr;
+  vx_launch_info_t li = {};
+  li.struct_size  = sizeof(li);
+  li.kernel       = kernel;
+  li.args_host    = &kernel_arg;
+  li.args_size    = sizeof(kernel_arg);
+  li.ndim         = 1;
+  li.grid_dim[0]  = 1;
+  li.block_dim[0] = warps * (uint32_t)num_threads;
+  li.lmem_size    = warps * (uint32_t)num_threads * sizeof(uint64_t);
+  RT_CHECK(vx_enqueue_launch(queue, &li, 0, nullptr, &launch_ev));
+
+  std::vector<uint64_t> h_out(warps * 2 + nthreads, 0);
+  RT_CHECK(vx_enqueue_read(queue, h_out.data(), out_buffer, 0, out_size, 1, &launch_ev, &read_ev));
+  RT_CHECK(vx_event_wait_value(read_ev, 1, VX_TIMEOUT_INFINITE));
+  vx_event_release(read_ev);
+  vx_event_release(launch_ev);
+
+  uint64_t lo = UINT64_MAX, hi = 0, worst = 0;
+  int errors = 0;
+  for (uint32_t w = 0; w < warps; ++w) {
+    uint64_t c0 = h_out[2 * w], c1 = h_out[2 * w + 1];
+    if (c1 <= c0) {
+      printf("*** error: warp %u start=%llu end=%llu\n", w, (unsigned long long)c0, (unsigned long long)c1);
+      ++errors;
+      continue;
+    }
+    lo = std::min(lo, c0);
+    hi = std::max(hi, c1);
+    worst = std::max(worst, c1 - c0);
+  }
+  uint64_t hash = 1469598103934665603ull;
+  for (uint64_t i = 0; i < nthreads; ++i)
+    hash = (hash ^ h_out[warps * 2 + i]) * 1099511628211ull;
+  if (errors == 0) {
+    printf("kind=%s W=%u iters=%u cyc_per_iter_warp=%.2f cyc_per_iter_sm=%.2f hash=%016llx\n", kNames[kind], warps, iters,
+           (double)worst / iters, (double)(hi - lo) / iters, (unsigned long long)hash);
+  }
+  cleanup();
+  if (errors != 0) {
+    std::cout << "Found " << errors << " errors!" << std::endl;
+    return 1;
+  }
+  std::cout << "PASSED!" << std::endl;
+  return 0;
+}
diff -ruN '--exclude=third_party' a/tests/regression/warp_rate/Makefile b/tests/regression/warp_rate/Makefile
--- a/tests/regression/warp_rate/Makefile	1969-12-31 19:00:00.000000000 -0500
+++ b/tests/regression/warp_rate/Makefile	2026-11-21 14:44:58.716550036 -0500
@@ -0,0 +1,16 @@
+ROOT_DIR := $(realpath ../../..)
+include $(ROOT_DIR)/config.mk
+
+PROJECT := warp_rate
+
+SRC_DIR := $(VORTEX_HOME)/tests/regression/$(PROJECT)
+
+SRCS := $(SRC_DIR)/main.cpp
+
+VX_SRCS := $(SRC_DIR)/kernel.cpp
+
+OPTS ?= -k0 -w1 -i64
+
+KERNEL_LIB := vortex2
+
+include ../common.mk
diff -ruN '--exclude=third_party' a/VX_config.toml b/VX_config.toml
--- a/VX_config.toml	2026-11-21 12:10:06.000000000 -0500
+++ b/VX_config.toml	2026-11-21 15:29:33.036166145 -0500
@@ -76,6 +76,19 @@
 VX_CFG_MAX_BAR_EVENTS = 32
 
 VX_CFG_IBUF_SIZE = 4
+# SimX only: instructions one warp may have between its fetch pick and decode.
+# 1 stalls the warp from its pick until decode, or for a branch or warp-control
+# instruction until that resolves. More fetches the warp sequentially ahead:
+# decode drops the younger fetches when it finds a stalling instruction or an
+# instruction out of order, and the warp refetches from its PC once released.
+# The instruction buffer (IBUF_SIZE) bounds it as well.
+VX_CFG_FETCH_INFLIGHT = 1
+# SimX only: 1 treats a floating-point operation's exception flags as an
+# accumulation (sticky OR), so a warp's FP operations no longer wait for each
+# other's flags; CSR accesses of fflags, frm or fcsr still wait for them, and
+# they for those. 0 serializes the flag writes, one FP operation of a warp at a
+# time, as the RTL scoreboard does with XREG_0.
+VX_CFG_FFLAGS_ACCUM = 0
 VX_CFG_DISPATCH_QUEUE_SIZE = 4
 # A power of two: a warp's issue slice is the low bits of its id.
 VX_CFG_ISSUE_WIDTH = "expr: pow(2, clog2(up($VX_CFG_NUM_WARPS / 16)))"
